; Processor metadata is static until the skin is refreshed.
[MeasureCPUModel]
Measure=Registry
RegHKey=HKEY_LOCAL_MACHINE
RegKey=HARDWARE\DESCRIPTION\System\CentralProcessor\0
RegValue=ProcessorNameString
UpdateDivider=-1

[MeasureCPUInfo]
Measure=Plugin
Plugin=RunCommand
Program=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe
Parameter=-NoLogo -NoProfile -NonInteractive -Command "[Console]::OutputEncoding=[System.Text.UTF8Encoding]::new($false); try { $cpus=@(Get-CimInstance -ClassName Win32_Processor -Property NumberOfCores,NumberOfLogicalProcessors -ErrorAction Stop); if ($cpus.Count -lt 1) { throw 'No processor' }; $physical=0; $logical=0; foreach ($cpu in $cpus) { if ($cpu.NumberOfCores -lt 1 -or $cpu.NumberOfLogicalProcessors -lt 1) { throw 'Counts unavailable' }; $physical+=[int]$cpu.NumberOfCores; $logical+=[int]$cpu.NumberOfLogicalProcessors }; [Console]::Write(('OK|{0}|{1}' -f $physical,$logical)) } catch { [Console]::Write('UNAVAILABLE') }"
State=Hide
OutputType=UTF8
Timeout=10000
; Updating reads cached command status/output; only OnRefreshAction launches Run.
UpdateDivider=1
FinishAction=[!UpdateMeasure MeasureCPUInfo][!CommandMeasure MeasureCPUController "ApplyProcessorInfo()"]

; Built-in process ranking. Its Process worker collects independently at 1 Hz.
[MeasureCPUProcess1]
Measure=Plugin
Plugin=UsageMonitor
Alias=CPU
Index=1
Blacklist=_Total|Idle
Rollup=1
MinValue=0
MaxValue=100
Disabled=1
DynamicVariables=1
UpdateDivider=1

