; Windows volume labels; Type must stay 0 because Type=1 overrides Label.
; Each slow update replaces the string, including clearing failed label queries.

[MeasureIONameA]
Measure=FreeDiskSpace
Drive=A:
Type=0
Label=1
IgnoreRemovable=0
Group=IOInventory
UpdateDivider=(Max(5,Ceil(#CapacityInterval#/1000)))

