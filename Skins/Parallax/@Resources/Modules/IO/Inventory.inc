; Native letter inventory; no process or filesystem enumeration.
; Rainmeter Type enum: 1 removed, 3 removable, 4 fixed, 5 network, 6 optical, 7 RAM.
[MeasureIOTypeA]
Measure=FreeDiskSpace
Drive=A:
Type=1
IgnoreRemovable=0
Group=IOInventory
UpdateDivider=(Max(5,Ceil(#CapacityInterval#/1000)))

