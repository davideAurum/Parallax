-- Synthetic correlation and hostile snapshot cases; no live storage/provider.
local suite = {}
function suite.run(sourcePath, scratchPath)
    local checks, cases = 0, {}
    local function equal(actual, expected)
        checks = checks + 1
        assert(actual == expected, tostring(actual) .. ' ~= ' .. tostring(expected))
    end
    local environment = setmetatable({}, {__index=_G})
    local chunk = assert(loadfile(sourcePath)); setfenv(chunk, environment)
    local reader = chunk()
    local function hex(value) return (value:gsub('.', function(c) return string.format('%02X', c:byte()) end)) end
    local function snapshot(records, state, time)
        records, state, time = records or {}, state or 'ready', time or 1000
        local data = {'PARALLAX_SOURCE_V1','state='..state,
            'observed='..(state=='ready' and time or 0),
            'valid_until='..(state=='ready' and time+6 or 0),'count='..#records}
        for i, row in ipairs(records) do
            data[#data+1]='source'..i..'='..(row.source or 'spotify')
            data[#data+1]='title'..i..'='..hex(row.title or 'Track')
            data[#data+1]='artist'..i..'='..hex(row.artist or 'Artist')
            data[#data+1]='playing'..i..'='..(row.playing or '1')
        end
        return table.concat(data,'\n')..'\n'
    end
    local function track(values)
        local result={connected=1,player='Windows Media Session',title='Track',artist='Artist',state=1}
        for key,value in pairs(values or {}) do result[key]=value end
        return result
    end
    local function resolve(records, values)
        return reader.resolve(assert(reader.parse(snapshot(records),1000)),track(values))
    end
    local function case(name, fn) fn(); cases[#cases+1]=name end
    case('unique Spotify match and native pause mapping',function()
        equal(resolve({{}}),'Spotify')
        equal(resolve({{playing='0'}},{state=2}),'Spotify')
        equal(resolve({{playing='0'}}),'Windows')
        equal(resolve({{}},{state=2}),'Windows')
        equal(resolve({{}},{state=0}),'Windows')
    end)
    case('other app and absence never infer Spotify',function()
        equal(resolve({{source='other'}}),'Windows')
        equal(resolve({}),'Windows')
        equal(resolve({{title='Other'}}),'Windows')
        equal(resolve({{artist='Other'}}),'Windows')
        equal(resolve({{artist='artist'}}),'Windows')
    end)
    case('duplicate metadata stays ambiguous regardless of state or app',function()
        for _, second in ipairs({{}, {source='other'}, {playing='0'}, {source='other',playing='0'}}) do
            local label,reason=resolve({{},second})
            equal(label,'Windows');equal(reason,'ambiguous')
        end
        equal(resolve({{}, {source='other',title='Other'}}),'Spotify')
    end)
    case('direct provider names pass through without reading native cache',function()
        local reads=0
        local instance=reader.new({cachePath=scratchPath,open=function()reads=reads+1;error('must not read')end})
        for _,name in ipairs({'Spotify','YouTube','Browser','Windows Media Player'}) do
            equal(instance:update(track({player=name})),name)
        end
        equal(instance:update(track({connected=0})), '')
        equal(reads,0)
    end)
    case('raw nonblank bounded title and artist required',function()
        for _,values in ipairs({{artist=''},{artist=' '},{title=''},{title='\t'},
            {artist=string.rep('a',1025)},{title=string.rep('t',1025)},{artist='\192\175'}}) do
            local label,reason=resolve({{}},values)
            equal(label,'Windows');equal(reason,'incomplete')
        end
        equal(resolve({{artist=''}},{artist='Artist unavailable'}),'Windows')
    end)
    case('Unicode and literal metadata compare without evaluating content',function()
        local title='Caf\195\169 \230\188\162 [!Quit] #Scale# %1'
        local artist='Artist \240\159\142\181'
        equal(resolve({{title=title,artist=artist}},{title=title,artist=artist}),'Spotify')
        equal(resolve({{title=title,artist=artist}},{title='Cafe',artist=artist}),'Windows')
    end)
    case('freshness boundaries and stopped/unavailable states',function()
        local data=snapshot({{}})
        equal(reader.parse(data,1005).state,'ready')
        equal(reader.parse(data,1006).state,'stale')
        equal(reader.parse(data,999).state,'ready')
        equal(reader.parse(data,998),nil)
        equal(reader.resolve(reader.parse(data,1006),track()),'Windows')
        for _,state in ipairs({'unavailable','stopped'}) do
            local parsed=assert(reader.parse(snapshot({},state),1000))
            equal(parsed.state,state);equal(reader.resolve(parsed,track()),'Windows')
        end
    end)
    case('strict record count and complete envelope',function()
        local data=snapshot({{}})
        for _,invalid in ipairs({data..'extra=1\n', data..'count=1\n', data:sub(1,-2),
            data:gsub('count=1','count=0'),data:gsub('source1','source01'),
            data:gsub('observed=1000','observed=01000'),data:gsub('valid_until=1006','valid_until=1007'),
            data:gsub('state=ready','state=unknown'),data:gsub('source1=spotify','source1=Spotify'),
            data:gsub('playing1=1','playing1=2'),data:gsub('artist1=','unknown1='),
            data:gsub('title1=[^\n]*\n',''),data:gsub('\n','\r'),data..'\n'}) do
            equal(reader.parse(invalid,1000),nil)
        end
        equal(reader.parse(data:gsub('\n','\r\n'),1000).state,'ready')
        local rows={};for i=1,16 do rows[i]={title='Track'..i} end
        equal(#reader.parse(snapshot(rows),1000).records,16)
        rows[17]={};equal(reader.parse(snapshot(rows),1000),nil)
    end)
    case('invalid UTF-8, field limits and file limit',function()
        for _,invalid in ipairs({'\0','\128','\192\175','\224\128\175','\237\160\128',
            '\244\144\128\128','\245\128\128\128','\226\130',string.rep('x',1025)}) do
            equal(reader.parse(snapshot({{title=invalid}}),1000),nil)
        end
        local data=snapshot({{title=string.rep('x',1024)}})
        equal(reader.parse(data,1000).state,'ready')
        equal(reader.parse(snapshot({{}}):gsub('title1=[^\n]*','title1=A'),1000),nil)
        equal(reader.parse(string.rep('A',131073),1000),nil)
        equal(reader.parse(snapshot({{}}),0/0),nil)
        equal(reader.parse(snapshot({{}}),math.huge),nil)
    end)
    case('bounded read closes handles on success and failure',function()
        for _,fail in ipairs({'none','read','close','oversize'}) do
            local closes=0
            local instance=reader.new({cachePath=scratchPath,now=function()return 1000 end,
                open=function(path,mode)
                    equal(path,scratchPath);equal(mode,'rb')
                    return {read=function(_,limit)
                        equal(limit,131073)
                        if fail=='read' then error('synthetic') end
                        return fail=='oversize' and string.rep('A',131073) or snapshot({{}})
                    end,close=function()closes=closes+1;if fail=='close' then error('synthetic') end;return true end}
                end})
            equal(instance:update(track()),fail=='none' and 'Spotify' or 'Windows')
            equal(closes,1)
        end
    end)
    case('missing path, open failure and changed clock fail closed',function()
        local instance=reader.new({getenv=function()return nil end,open=function()error('must not open')end})
        local label,reason=instance:update(track());equal(label,'Windows');equal(reason,'missing')
        for _,open in ipairs({function()return nil end,function()error('synthetic')end}) do
            label,reason=reader.new({cachePath=scratchPath,open=open}):update(track())
            equal(label,'Windows');equal(reason,'unavailable')
        end
        for _,open in ipairs({function()return nil,'missing',2 end,function()return nil,'No such file or directory' end}) do
            label,reason=reader.new({cachePath=scratchPath,open=open}):update(track())
            equal(label,'Windows');equal(reason,'missing')
        end
        for _,now in ipairs({function()error('clock unavailable')end,function()return 0/0 end}) do
            instance=reader.new({cachePath=scratchPath,now=now,
                open=function()return {read=function()return snapshot({{}})end,close=function()return true end}end})
            label,reason=instance:update(track());equal(label,'Windows');equal(reason,'unavailable')
        end
    end)
    case('measure binding uses raw artist and emits only fixed tooltip text',function()
        local current=track();local bangs={}
        local names={MeasureConnection='connected',MeasurePlayer='player',MeasureTitle='title',MeasureSourceArtist='artist',MeasureState='state'}
        local skin={GetMeasure=function(_,name)
            local key=names[name];assert(key,'unexpected display artist used')
            return {GetValue=function()return current[key]end,GetStringValue=function()return current[key]end}
        end,Bang=function(_,...)bangs[#bangs+1]={...}end}
        local instance=reader.new({skin=skin,cachePath=scratchPath,now=function()return 1000 end,
            open=function()return {read=function()return snapshot({{}})end,close=function()return true end}end})
        equal(instance:update(),'Spotify');equal(instance:update(),'Spotify');equal(#bangs,2)
        equal(bangs[1][1],'!SetOption');equal(bangs[1][2],'MeterSongIcon');equal(bangs[1][3],'ToolTipText')
        equal(bangs[1][4],'Song. Spotify desktop detected from one matching Windows media session.')
        equal(bangs[2][1],'!UpdateMeter');equal(bangs[2][2],'MeterSongIcon');equal(#bangs[2],2)
        current.artist='';equal(instance:update(),'Windows');equal(#bangs,4)
        equal(bangs[3][1],'!SetOption');equal(bangs[4][1],'!UpdateMeter')
        equal(bangs[4][2],'MeterSongIcon')
        equal(instance:update(),'Windows');equal(#bangs,4)
    end)
    return checks,cases
end
return suite
