-- Developer-only checks for AlbumColors.lua's pure color rules. Inputs are the
-- Chameleon 1.6.5 outputs measured on 2026-11-19 for a warm, a cool and a
-- grayscale cover (docs/superpowers/specs/2026-11-19-media-queue-art-and-album-colors-design.md).
local Suite = {}

function Suite.Run(AlbumColors)
    local passed = 0
    local function check(condition, message)
        if not condition then error(message, 2) end
        passed = passed + 1
    end
    local function equal(actual, expected, message)
        check(actual == expected, (message or 'value') .. ': expected ' .. tostring(expected) .. ', got ' .. tostring(actual))
    end

    -- Parsing: Chameleon hex and suite decimal colors.
    local c = AlbumColors.parse('CD4F2C')
    equal(c[1], 205); equal(c[2], 79); equal(c[3], 44)
    c = AlbumColors.parse('15,15,15,255')
    equal(c[1], 15); equal(c[3], 15)
    equal(AlbumColors.parse(''), nil, 'empty sample is no color')
    equal(AlbumColors.parse('300,0,0'), nil, 'out of range')

    -- HSL round trip stays within a unit.
    for _, raw in ipairs({ 'CD4F2C', '1A9A8D', '863C30', 'FFFF8A', '116161' }) do
        local color = AlbumColors.parse(raw)
        local back = AlbumColors.fromHsl(AlbumColors.toHsl(color))
        for i = 1, 3 do check(math.abs(back[i] - color[i]) <= 1, 'round trip ' .. raw) end
    end

    local function lightness(color) local _, _, l = AlbumColors.toHsl(color); return l end
    local function saturation(color) local _, s = AlbumColors.toHsl(color); return s end

    -- Warm cover.
    local warm = AlbumColors.palette('FFFF8A', 'CD4F2C', '863C30')
    check(warm ~= nil, 'warm cover has a palette')
    equal(table.concat(warm.main, ','), '134,60,48', 'saturated Average is the main color')
    check(lightness(warm.text1) >= 0.68 - 0.005 and lightness(warm.text2) >= 0.68 - 0.005, 'warm text readable on black')
    check(saturation(warm.text1) <= 0.85 + 0.01, 'text saturation capped')
    check(lightness(warm.media) >= 0.55 - 0.005 and lightness(warm.media) <= 0.75 + 0.005, 'media lightness band')
    check(table.concat(warm.text1, ',') ~= table.concat(warm.text2, ','), 'two distinct text colors')
    check(lightness(warm.text1) >= lightness(warm.text2), 'the gradient starts on the lighter color (mockup F)')

    -- Cool cover: Light2 sits at the same hue as Light1, so text2 is shifted.
    local cool = AlbumColors.palette('1A9A8D', '116161', '237A72')
    check(cool ~= nil, 'cool cover has a palette')
    check(lightness(cool.text1) >= 0.675, 'cool text lifted to readable')
    check(table.concat(cool.text1, ',') ~= table.concat(cool.text2, ','), 'same-hue cover still gets two colors')

    -- Grayscale, empty (no plugin) and fallback white/black: theme.
    equal(AlbumColors.palette('CECECE', '9F9F9F', '787878'), nil, 'grayscale cover keeps the theme')
    equal(AlbumColors.palette('', '', ''), nil, 'no samples keep the theme')
    equal(AlbumColors.palette('FFFFFF', '000000', 'FFFFFF'), nil, 'fallback samples keep the theme')

    -- Muted covers (2026-11-24). Samples of an olive cover, a few levels either
    -- side of the 18% cutoff, as its full-size file and its thumbnail can be.
    local olive = AlbumColors.palette('CDD6DB', 'A6AE92', '3F4637')
    check(olive ~= nil, 'a muted cover has a palette')
    equal(table.concat(olive.main, ','), '63,70,55', 'its tinted Average is the main color')
    check(lightness(olive.text1) >= 0.675 and lightness(olive.text2) >= 0.675, 'muted text is readable')
    check(saturation(olive.text1) >= 0.34 and saturation(olive.text2) >= 0.34, 'and lifted from gray')
    check(saturation(olive.text1) <= 0.36, 'but not past the floor')
    check(table.concat(olive.text1, ',') ~= table.concat(olive.text2, ','), 'its two tints are both used')
    check(saturation(olive.media) >= 0.34, 'media color as for any cover')
    local above = AlbumColors.palette('C7D5DB', 'A6AE92', '3F4637')
    equal(table.concat(above.main, ','), '199,213,219', 'a cover that already had color is unchanged')
    check(saturation(above.text1) < 0.34, 'and its text is not lifted')
    for _, gray in ipairs({ { 'FCFCFC', 'FCFCFC', 'DADADE' }, { 'A29E97', 'A29E97', '827A73' }, { 'F1F1F0', 'F1F1F0', '7F7F7D' },
            { 'ECECEC', 'A5A5A5', '111111' }, { '09090A', '0B0B0D', '0A0A0C' }, { 'F6F6F8', 'F4F4F5', 'E9E9EC' } }) do
        equal(AlbumColors.palette(gray[1], gray[2], gray[3]), nil, 'still colorless: ' .. table.concat(gray, ' '))
    end

    -- Tint: 10% toward the main color, clamped to 30%.
    local t = AlbumColors.tint({ 45, 45, 45 }, { 145, 45, 45 }, 10)
    equal(table.concat(t, ','), '55,45,45')
    equal(table.concat(AlbumColors.tint({ 0, 0, 0 }, { 100, 100, 100 }, 90), ','), '30,30,30', 'tint clamps at 30%')
    equal(table.concat(AlbumColors.tint({ 9, 9, 9 }, { 100, 100, 100 }, 0), ','), '9,9,9', 'zero tint keeps the gray')

    -- Option strings: the theme reproduces the ini values; a palette never
    -- changes the panel fill or touches the transport.
    local theme = { media = '137,190,250', header = '175,175,175', text = '220,220,220', background = '15,15,15,255',
        border = '50,50,50,255', sheet = '45,45,45,255', track = '50,50,50,255', off = '25,25,25,255', artist = '1,2,3,255',
        rgb = { border = { 50, 50, 50 }, sheet = { 45, 45, 45 }, track = { 50, 50, 50 }, off = { 25, 25, 25 } } }
    local options, variables, spectrum = AlbumColors.options(theme, nil, 10, nil)
    local byKey = {}
    for _, o in ipairs(options) do
        byKey[o[1] .. ':' .. o[2]] = o[3]
        check(not o[1]:find('Previous') and not o[1]:find('PlayPause') and not o[1]:find('Next'), 'transport untouched')
    end
    equal(byKey['MeterProgress:BarColor'], '137,190,250')
    equal(byKey['MeterProgress:SolidColor'], '50,50,50,255')
    equal(byKey['MeterPanel:MediaPanelPaint'], 'Fill Color 15,15,15,255 | Stroke Color 50,50,50,255 | StrokeWidth (#BorderThickness#*#Scale#)')
    equal(byKey['MeterQueueDrawer:MediaSheetPaint'], 'Fill Color 45,45,45,255 | Stroke Color 50,50,50,255 | StrokeWidth (#BorderThickness#*#Scale#)')
    equal(byKey['MeterTrackTitle:InlineSetting'], 'Color | 220,220,220')
    for index = 1, 5 do
        equal(byKey['MeterQueueArtist' .. index .. ':FontColor'], '1,2,3,255', 'theme keeps the queue artist color')
        equal(byKey['MeterQueueRow' .. index .. ':InlineSetting'], 'Color | 1,2,3,255')
        equal(byKey['MeterQueueRow' .. index .. ':FontColor'], nil, 'queue song titles keep the theme')
    end
    equal(byKey['MeterQueueHeaderTrack:InlineSetting'], 'Color | 1,2,3,255')
    equal(spectrum, nil, 'theme leaves the spectrum palette alone')
    equal(variables[1][2], '25,25,25,255')

    options, variables, spectrum = AlbumColors.options(theme, warm, 10, { title = 0.4, artist = 2, album = 0 })
    byKey = {}
    for _, o in ipairs(options) do byKey[o[1] .. ':' .. o[2]] = o[3] end
    check(byKey['MeterPanel:MediaPanelPaint']:find('^Fill Color 15,15,15,255 |'), 'panel fill stays black')
    check(byKey['MeterTrackTitle:InlineSetting']:find('^GradientColor | 180 | ') and byKey['MeterTrackTitle:InlineSetting']:find('; 0%.4000$'),
        'gradient ends where the title ends')
    check(byKey['MeterArtist:InlineSetting']:find('; 1%.0000$'), 'fraction capped at 1')
    check(byKey['MeterAlbum:InlineSetting']:find('; 0%.0500$'), 'fraction floor keeps a visible gradient')
    equal(byKey['MeterProgress:BarColor'], table.concat(warm.media, ','))
    local artist = table.concat(warm.text1, ',')
    for index = 1, 5 do
        equal(byKey['MeterQueueArtist' .. index .. ':FontColor'], artist, 'queue artists take the lighter text color')
        equal(byKey['MeterQueueRow' .. index .. ':InlineSetting'], 'Color | ' .. artist, 'so does a Compact row')
        equal(byKey['MeterQueueRow' .. index .. ':FontColor'], nil, 'queue song titles never do')
    end
    equal(byKey['MeterQueueHeaderTrack:InlineSetting'], 'Color | ' .. artist)
    check(byKey['MeterProgress:SolidColor'] ~= '50,50,50,255', 'track tinted')
    check(spectrum:find('^180 | '), 'spectrum runs left to right')
    check(variables[2][2] ~= '50,50,50,255', 'border variable tinted for the toggle ring')
    return passed
end

return Suite
