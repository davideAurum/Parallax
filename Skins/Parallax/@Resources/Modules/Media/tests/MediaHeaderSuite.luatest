-- Developer-only synthetic tests; excluded from skin packaging.
-- The native runner decodes the unchanged UTF-16 production text for loadfile.
local suite = {}

function suite.run(sourcePath)
    local passed, cases = 0, {}
    local function check(condition, message)
        assert(condition, message)
        passed = passed + 1
    end
    local function scenario(name, test)
        local before = passed
        test()
        cases[#cases + 1] = name .. ': ' .. (passed - before) .. ' assertions'
    end
    local function fixture(overrides, columns, bangs)
        local values = {
            MeasureConnection = { value = 1 }, MeasurePlayer = { text = 'Spotify' },
            MeasureMediaSource = { text = 'Spotify' }, MeasureTitle = { text = 'Synthetic fixture title' },
            MeasureState = { value = 1 }
        }
        for name, value in pairs(overrides or {}) do values[name] = value end
        local calls = 0
        local mock = {}
        function mock:GetMeasure(name)
            local value = values[name]
            assert(value ~= nil, 'Unexpected measure lookup: ' .. tostring(name))
            if value == false then return nil end
            return { GetValue = function() return value.value end, GetStringValue = function() return value.text end }
        end
        function mock:GetVariable(name, default)
            assert(name == 'Columns', 'Unexpected variable lookup: ' .. tostring(name))
            if columns == nil then return default end
            return columns
        end
        function mock:Bang(...)
            if bangs then bangs[#bangs + 1] = table.concat({ ... }, ' ') return end
            calls = calls + 1
            error('A title that offers no setting must never issue a bang; MediaPulse.lua owns the icon')
        end
        local env = setmetatable({ SKIN = mock }, { __index = _G })
        local chunk = assert(loadfile(sourcePath))
        setfenv(chunk, env)
        chunk()
        env.Initialize()
        check(calls == 0, 'Initialize must not issue commands')
        local f = { env = env, values = values }
        f.label = columns == '1' and 'Media' or 'Media Player'
        function f.expect(name)
            check(env.Update() == f.label .. ': ' .. name, 'Incorrect title')
            check(env.GetPlayerName() == name, 'Getter identity disagrees with Update')
            check(calls == 0, 'A title update must not swap the icon or issue actions')
        end
        return f
    end

    scenario('compact layout shortens the label and keeps the state or player', function()
        for _, case in ipairs({ { nil, 'Media Player' }, { '2', 'Media Player' }, { '1', 'Media' },
                { '', 'Media Player' }, { '3', 'Media Player' }, { ' 1', 'Media Player' } }) do
            local f = fixture(nil, case[1])
            check(f.env.Update() == case[2] .. ': Spotify', 'Playing title uses the layout label')
            f.values.MeasureState.value = 2
            check(f.env.Update() == case[2] .. ': paused', 'Paused title uses the layout label')
            f.values.MeasureConnection.value = 0
            check(f.env.Update() == case[2] .. ': stopped', 'Stopped title uses the layout label')
            check(f.env.GetPlayerName() == 'stopped', 'Getter stays the bare identity')
        end
    end)

    scenario('specific player and metadata changes remain passive', function()
        local f = fixture()
        f.expect('Spotify')
        f.expect('Spotify')
        f.values.MeasureTitle.text = 'Another synthetic title'
        f.expect('Spotify')
        for _, name in ipairs({ 'YouTube', 'VLC', 'Firefox', 'Windows Media Player', 'Apple Music', 'Synthetic unknown player', 'Spotify' }) do
            f.values.MeasurePlayer.text = name
            f.expect(name)
        end
    end)

    scenario('Windows identity requires the correlated source reader', function()
        local f = fixture()
        for _, raw in ipairs({ 'Windows', 'Windows Media Session', ' WINDOWS MEDIA SESSION ', '\twInDoWs\n' }) do
            f.values.MeasurePlayer.text = raw
            for _, source in ipairs({ '', 'Windows', 'YouTube', 'Spotify.exe', 'Spotify Web', '[!Quit]Spotify' }) do
                f.values.MeasureMediaSource.text = source
                f.expect('Unknown')
            end
            f.values.MeasureMediaSource.text = ' \tSpOtIfY\n'
            f.expect('Spotify')
            f.values.MeasureMediaSource.text = 'Windows'
            f.expect('Unknown')
        end
        f.values.MeasurePlayer.text = ''
        f.values.MeasureMediaSource.text = 'Spotify'
        f.expect('Unknown')
        f.values.MeasurePlayer = false
        f.env.Initialize()
        f.expect('Unknown')
    end)

    scenario('a never-started source helper is named and only then does a click open Media settings', function()
        local opens = '!ActivateConfig Parallax\\Media\\Settings Settings.ini'
        local on, off = '!SetOption MeterHeading MouseActionCursor 1', '!SetOption MeterHeading MouseActionCursor 0'
        for _, columns in ipairs({ '2', '1' }) do
            local bangs = {}
            local f = fixture({ MeasurePlayer = { text = 'Windows Media Session' },
                MeasureMediaSource = { text = 'Not started' } }, columns, bangs)
            check(f.env.OpenSettings() == false, 'No click before the first sample')
            f.expect('detection off')
            f.expect('detection off')
            check(#bangs == 1 and bangs[1] == on, 'The hand cursor is set once, not per update')
            check(f.env.OpenSettings() == true and #bangs == 2 and bangs[2] == opens, 'A click opens Media settings')
            -- Started: the reader reports an ordinary result, whichever it is.
            for _, started in ipairs({ { 'Spotify', 'Spotify' }, { 'Windows', 'Unknown' } }) do
                f.values.MeasureMediaSource.text = started[1]
                local before = #bangs
                f.expect(started[2])
                check(#bangs == before + 1 and bangs[#bangs] == off, 'Offer withdrawn once the helper has reported')
                check(f.env.OpenSettings() == false and #bangs == before + 1, 'An ordinary title ignores clicks')
                f.values.MeasureMediaSource.text = 'Not started'
                f.expect('detection off')
                check(bangs[#bangs] == on, 'Offer returns')
            end
            -- Paused, stopped, disconnected and named players offer nothing,
            -- even a player that calls itself what the title or reader says.
            for _, case in ipairs({ { 'MeasureState', 'value', 2, 1, 'paused' }, { 'MeasureState', 'value', 0, 1, 'stopped' },
                    { 'MeasureConnection', 'value', 0, 1, 'stopped' },
                    { 'MeasurePlayer', 'text', 'detection off', 'Windows Media Session', 'detection off' },
                    { 'MeasurePlayer', 'text', 'Not started', 'Windows Media Session', 'Not started' } }) do
                f.values[case[1]][case[2]] = case[3]
                f.expect(case[5])
                check(bangs[#bangs] == off and f.env.OpenSettings() == false, 'Only the reader result offers the setting')
                f.values[case[1]][case[2]] = case[4]
                f.expect('detection off')
            end
            -- A refresh starts over from the ini's plain cursor.
            f.env.Initialize()
            check(f.env.OpenSettings() == false, 'A refresh withdraws the offer until the next sample')
        end
    end)

    scenario('setup disconnected and idle states read stopped and cannot retain a player', function()
        local setup = fixture({ MeasureConnection = false, MeasureState = false, MeasurePlayer = false,
            MeasureMediaSource = false, MeasureTitle = false })
        setup.expect('stopped')
        local f = fixture()
        f.expect('Spotify')
        for _, connection in ipairs({ 0, -1, 2, 'invalid', 0 / 0, math.huge, -math.huge, false }) do
            f.values.MeasureConnection.value = connection
            f.expect('stopped')
        end
        f.values.MeasureConnection.value = nil
        f.expect('stopped')
        f.values.MeasureConnection.value = '1'
        f.expect('Spotify')
        for _, title in ipairs({ '', ' ', '\t\r\n', false }) do
            f.values.MeasureTitle.text = title
            f.expect('stopped')
        end
        f.values.MeasureTitle.text = nil
        f.expect('stopped')
        f.values.MeasureTitle.text = 'Synthetic resumed title'
        f.expect('Spotify')
        f.values.MeasureTitle = false
        f.env.Initialize()
        f.expect('stopped')
    end)

    scenario('only a reported Playing state names the player; Paused reads paused', function()
        local f = fixture()
        f.values.MeasurePlayer.text = 'Windows Media Session'
        f.expect('Spotify')
        for _, state in ipairs({ 2, 0, 3, -1, 'invalid', 0 / 0, math.huge, -math.huge, false }) do
            f.values.MeasureState.value = state
            f.expect(state == 2 and 'paused' or 'stopped')
        end
        f.values.MeasureState.value = nil
        f.expect('stopped')
        f.values.MeasureState.value = '1'
        f.expect('Spotify')
        f.values.MeasureState.value = 1
        f.values.MeasurePlayer.text = 'VLC'
        f.expect('VLC')
        f.values.MeasureState.value = 2
        f.expect('paused')
        f.values.MeasureTitle.text = ''
        f.expect('stopped', 'paused without a track reads stopped')
        f.values.MeasureTitle.text = 'Synthetic title'
        f.values.MeasureConnection.value = 0
        f.expect('stopped', 'disconnected paused state reads stopped')
        f.values.MeasureConnection.value = 1
        f.values.MeasureState = false
        f.env.Initialize()
        f.expect('stopped')
    end)

    scenario('specific WNP names preserve case whitespace and stale-source priority', function()
        local f = fixture()
        for _, name in ipairs({ 'spotify', 'youtube music', 'vlc media player', 'google chrome', 'microsoft edge',
            'mozilla firefox', 'brave', 'opera gx', 'vivaldi', 'groove music', 'apple music', 'itunes' }) do
            for _, raw in ipairs({ name, ' \t' .. name:upper() .. '\r\n' }) do
                f.values.MeasurePlayer.text = raw
                f.expect(raw)
            end
        end
    end)

    scenario('missing source preserves specific WNP names without inference', function()
        local f = fixture({ MeasureMediaSource = false })
        f.expect('Spotify')
        f.values.MeasurePlayer.text = 'Windows Media Session'
        f.expect('Unknown')
        f.values.MeasurePlayer.text = 'Windows Media Player'
        f.expect('Windows Media Player')
        f.values.MeasurePlayer.text = nil
        f.expect('Unknown')
        f.values.MeasurePlayer.text = 42
        f.expect('Unknown')
    end)

    scenario('Unicode malformed bytes controls and injection remain data only', function()
        local f = fixture()
        for _, name in ipairs({
            'Caf\195\169 \230\188\162 \240\159\142\181',
            '[!Quit]#AccentColor#[MeasurePlayer][&MeasurePlayer:Update()]',
            'Synthetic\r\n[Rainmeter]\nOnRefreshAction=[!Quit]',
            'Synthetic\0player', 'Synthetic\255\192\128player',
            'Spotify.exe', 'Spotify Web', 'YouTube Evil', 'Evil VLC', 'Apple Music plus',
            'Windows Media Session extra', 'Media Player', 'stopped', string.rep('Synthetic ', 400)
        }) do
            f.values.MeasurePlayer.text = name
            f.expect(name)
        end
    end)

    scenario('read-only getter and refresh reset have no hidden actions', function()
        local f = fixture()
        check(f.env.GetPlayerName() == 'Spotify', 'Getter should read sampled identity before Update')
        f.expect('Spotify')
        f.env.Initialize()
        f.expect('Spotify')
    end)

    return passed, cases
end

return suite
