-- Developer-only observer for isolated copies of the actual production skins.
-- No external commands are executed; only scalar preference controls are used.
local tick, done, checks, previous_checks, stage, kind = 0, false, 0, 0, 1, ''
-- Ticks to wait before observing a stage. Identity transitions raise it to
-- cover MeasureMediaHeader's own cadence (#MediaLegacyDivider# ticks).
local settle_ticks=3
local glyph_report=''
local fit_report={}
local identity_preferences
local identity_metadata={}
local queue_transport_checks
local artwork_bounds
local timing_report=''
local settings_expanded_height
local function is_settings() return kind:match('Settings$')~=nil end
local function check(ok, message) checks=checks+1; assert(ok, message) end
local function read(path)
    local file=assert(io.open(path,'rb')); local value=file:read('*a'); file:close(); return value
end
local function write(path, value)
    local file=assert(io.open(path,'wb')); assert(file:write(value)); assert(file:close())
end
local function preferences()
    local bytes=read(SELF:GetOption('PreferencesPath'))
    if bytes:sub(1,2)=='\255\254' then
        bytes=bytes:sub(3):gsub('(.).', '%1')
    elseif bytes:sub(1,2)=='\254\255' then
        bytes=bytes:sub(3):gsub('.(.)', '%1')
    end
    local values={}
    for key,value in bytes:gmatch('([%w_]+)=([^\r\n]+)') do values[key]=value end
    check(values.UnrelatedSentinel=='preserve-me','Unrelated preference changed')
    check(values.PanelHeight=='162' and values.MediaInterval=='1000','Base height/cadence changed')
    check(tonumber(values.Scale)==SELF:GetNumberOption('ExpectedScale'),'Scale preference changed')
    check(tonumber(values.ColumnWidth)==SELF:GetNumberOption('ExpectedWidth'),'ColumnWidth preference changed')
    local allowed={Columns=true,PanelHeight=true,MediaInterval=true,QueueExpanded=true,QueueRowLimit=true,
        QueueShowDetails=true,QueuePollSeconds=true,Scale=true,ColumnWidth=true,UnrelatedSentinel=true}
    for key in pairs(values) do check(allowed[key],'Unexpected preference written: '..key) end
    return values
end
local function text(name) return assert(SKIN:GetMeter(name)):GetOption('Text','') end
local function formula(expression) return tonumber(SKIN:ParseFormula(SKIN:ReplaceVariables('('..expression..')'))) end
-- Independent model of the drawer layout. It mirrors media_body_geometry and
-- media_drawer_geometry in test_skin_contract.py from the same primitives,
-- rather than reading the skin's derived variables back, so a geometry edit
-- has to agree with a second calculation. Offsets are #Inset#-relative;
-- window and width are absolute.
local function media_geometry(expanded, rows)
    local scale=SELF:GetNumberOption('ExpectedScale')
    local wide=SELF:GetNumberOption('ExpectedColumns')==2
    local rounded=function(value) return math.floor(value+0.5) end
    local gap=2*rounded(tonumber(SKIN:GetVariable('Gutter'))*scale/2)
    local inset=gap/2
    local padding=rounded(tonumber(SKIN:GetVariable('PanelPadding'))*scale)
    local columns=wide and 2 or 1
    local unit=rounded(SELF:GetNumberOption('ExpectedWidth')*scale)
    local panel_width=columns*(unit+gap)-gap
    local offset=wide and rounded(12*scale) or 0
    local bar=math.max(1,rounded(SELF:GetNumberOption('ExpectedBarThickness',6)*scale))
    -- One 26px title row at both widths, a 4px section gap, three 24px
    -- metadata rows, another 4px gap and the bar's 6px optical pad.
    local progress=offset+112*scale
    -- The panel ends one padding below the timing text (MediaQueueHidden=1).
    local body=math.ceil(progress+bar+20*scale+padding)
    -- Wide art reaches the body's lower edge plus the offset it overhangs by;
    -- compact art keeps its 36px thumbnail, topped with the metadata block.
    local cover=wide and rounded(body+offset) or rounded(48*scale*0.75)
    local cover_x=wide and 0 or padding
    local cover_y=wide and 0 or 30*scale
    local content_x=wide and cover+8*scale or padding
    local size,pad,button_gap=34*scale,5*scale,4*scale
    -- Transport circles: statically centred between the art's right edge and
    -- the panel's, and centred vertically on the panel's lower border.
    local transport_x=(cover_x+cover+panel_width)/2-(3*size+2*button_gap)/2
    local queue_top=math.max(cover_y+cover,body)+4*scale
    local queue_bottom=queue_top+(1+rows)*18*scale+5*scale
    local drawer_bottom=expanded and queue_bottom+8*scale or body
    local overhang=math.max(cover_y+cover,body+(size+2*pad)/2)
    local window=math.max(body+gap,math.ceil(overhang+2*inset),math.ceil(drawer_bottom+2*inset))
    return {scale=scale,wide=wide,inset=inset,padding=padding,offset=offset,bar=bar,progress=progress,body=body,
        cover=cover,cover_x=cover_x,cover_y=cover_y,content_x=content_x,content_right=panel_width-padding,
        surface_x=wide and 96*scale or 0,transport_x=transport_x,transport_size=size,transport_pad=pad,
        transport_box=size+2*pad,transport_step=size+button_gap,tab_y=progress+bar+padding,
        tab_right=transport_x-pad-4*scale,queue_top=queue_top,rows_y=queue_top+23*scale,
        drawer_bottom=drawer_bottom,window=window,width=columns*(unit+gap)}
end
local function dimensions(expanded, rows)
    local scale=SELF:GetNumberOption('ExpectedScale')
    local width=SELF:GetNumberOption('ExpectedWidth')
    local columns=is_settings() and 2 or SELF:GetNumberOption('ExpectedColumns')
    local gap=2*math.floor(tonumber(SKIN:GetVariable('Gutter'))*scale/2+0.5)
    local expected_w=columns*(math.floor(width*scale+0.5)+gap)
    local expected_h=is_settings() and math.floor((expanded and 554 or 498)*scale+0.5)+gap or media_geometry(expanded,rows).window
    local detail=''
    if is_settings() and SKIN:GetH()~=expected_h then
        local bounds,panel=SKIN:GetMeter('MeterBounds'),SKIN:GetMeter('MeterPanel')
        detail=string.format('; SettingsPanelHeight=%s PanelHeightPx=%s WindowHeight=%s BoundsH=%g/%s PanelH=%g',
            SKIN:GetVariable('SettingsPanelHeight'),SKIN:GetVariable('PanelHeightPx'),SKIN:GetVariable('WindowHeight'),
            bounds:GetH(),bounds:GetOption('H','',true),panel:GetH())
    end
    check(SKIN:GetW()==expected_w and SKIN:GetH()==expected_h,
        string.format('Native skin bounds %dx%d expected %dx%d%s',SKIN:GetW(),SKIN:GetH(),expected_w,expected_h,detail))
    return expected_w,expected_h
end
local function inside(name, width, height)
    local meter=assert(SKIN:GetMeter(name)); local x,y,w,h=meter:GetX(true),meter:GetY(true),meter:GetW(),meter:GetH()
    if w==0 or h==0 then return end
    local alignment=meter:GetOption('StringAlign','Left')
    if alignment:match('^Center') then x=x-w/2 elseif alignment:match('^Right') then x=x-w end
    local vertical=alignment:match('^Left(.*)$') or alignment:match('^Right(.*)$') or alignment:match('^Center(.*)$') or ''
    if vertical=='Center' then y=y-h/2 elseif vertical=='Bottom' then y=y-h end
    check(x>=0 and y>=0 and x+w<=width+1 and y+h<=height+1,
        string.format('%s outside skin %.2f,%.2f,%.2f,%.2f',name,x,y,w,h))
end
-- The 2026-10-04 header: one title row at both widths. MeterHeading shows
-- MeasureMediaHeader whole: "Media Player: " ("Media: " at one column), then
-- the player while a track plays, "paused" while one is paused, otherwise
-- "stopped". One title-icon slot precedes it; MediaPulse.lua shows exactly
-- one of the two icons.
local function title_label() return SELF:GetNumberOption('ExpectedColumns')==2 and 'Media Player: ' or 'Media: ' end
local function header_row(state)
    if state==nil then state=kind:find('Player',1,true) and 'Spotify' or 'stopped' end
    local expected=title_label()..state
    local g=media_geometry(false,5)
    local scale=g.scale
    local surface=g.inset+g.offset
    local content_x=g.inset+g.content_x
    local title=assert(SKIN:GetMeter('MeterHeading'))
    check(SKIN:GetMeter('MeterPlayerName')==nil,'The removed player-name row is back')
    check(SKIN:GetMeasure('MeasureMediaHeader'):GetStringValue()==expected,'Header value '..SKIN:GetMeasure('MeasureMediaHeader'):GetStringValue()..' expected '..expected)
    check(title:GetOption('MeasureName')=='MeasureMediaHeader' and title:GetOption('Text')=='%1','Title does not bind the header measure as data')
    check(title:GetOption('ToolTipText','')=='','Title must not repeat its visible text in a tooltip')
    check(title:GetOption('ClipString')=='1' and title:GetOption('UpdateDivider')=='1','Title must clip and follow every header update')
    check(title:GetOption('FontColor')==SKIN:GetVariable('TitleTextColor'),'Title ignores title color')
    local size=tonumber(title:GetOption('FontSize')) or SKIN:ParseFormula(title:GetOption('FontSize'))
    check(math.abs(size-tonumber(SKIN:GetVariable('TitleFontSize'))*scale)<0.001,'Title ignores title font size')
    local icon_size=14*scale*tonumber(SKIN:GetVariable('TitleFontSize'))/10
    check(math.abs(title:GetY(true)-(surface+15*scale))<=1,'Title is not on the shared row center')
    check(math.abs(title:GetX(true)-(content_x+icon_size+4*scale))<=1,'Title does not follow the icon slot and gap')
    check(math.abs(title:GetW()-(g.content_right-g.content_x-icon_size-28*scale))<=1,'Title does not end 24px before the content edge')
    check(title:GetX(true)+title:GetW()<=SKIN:GetMeter('MeterMediaOptions'):GetX(true),'Title overlaps the gear')
    local media,player=SKIN:GetMeter('MeterMediaIcon'),SKIN:GetMeter('MeterPlayerIcon')
    -- Only a playing track swaps in Audio Lines; paused keeps Monitor Play.
    local playing=state~='stopped' and state~='paused'
    local shown,hidden=playing and player or media,playing and media or player
    check(shown:GetW()>0 and hidden:GetW()==0 and hidden:GetH()==0,'Exactly one title icon must show for '..expected)
    for _,icon in ipairs({media,player}) do
        check(icon:GetOption('Meter')=='Shape' and icon:GetOption('Group')=='MediaPlayerIcons','Title icon escaped its Shape group')
        check(math.abs(icon:GetX(true)-content_x)<=1,'Title icon slot is not at ContentX')
    end
    check(media:GetY(true)==player:GetY(true),'Title icons do not share one slot')
    check(math.abs(shown:GetW()-icon_size)<=1 and math.abs(shown:GetH()-icon_size)<=1,'Title icon ignores TitleIconSize')
    -- Native boxes are whole pixels, so compare rendered centers with each
    -- other; the title anchor itself was checked against the model above.
    check(math.abs(shown:GetY(true)+shown:GetH()/2-title:GetY(true))<=1,
        string.format('Title icon center %g is not on the title row %g',shown:GetY(true)+shown:GetH()/2,title:GetY(true)))
    check(shown:GetX(true)+shown:GetW()<=title:GetX(true)+1,'Title icon overlaps the title')
    local first=SKIN:GetMeter(kind:find('Player',1,true) and 'MeterTrackTitle' or 'MeterSetupStatus')
    if first:GetH()>0 then
        local top=first:GetY(true)-(first:GetOption('StringAlign')=='LeftCenter' and first:GetH()/2 or 0)
        check(math.abs(top-(surface+30*scale))<=1,'First content row does not follow the 26px header and 4px gap')
    end
end
-- LayoutTransport is disabled while the transport straddles the panel border
-- (Media.lua, TEMPORARY), so the row is placed statically. The timing text
-- keeps its own contract: right aligned under the bar, capped, auto-width.
local function transport_layout(active_name)
    local g=media_geometry(false,5)
    local scale,inset=g.scale,g.inset
    local active=assert(SKIN:GetMeter(active_name))
    local left=active:GetX(true)-active:GetW()
    local bar=SKIN:GetMeter('MeterProgress')
    local bar_width=bar:GetW()>0 and bar:GetW() or SKIN:ParseFormula(SKIN:ReplaceVariables(bar:GetOption('W')))
    -- Compact art sits above this row, so the cap runs from the content edge.
    local transport_left=g.wide and g.cover_x+g.cover or g.content_x
    local cap=math.max(1,g.content_right-transport_left-104*scale)
    local detail=string.format('%s width=%g left=%g cap=%g',active_name,active:GetW(),left,cap)
    check(math.abs(active:GetY(true)-bar:GetY(true)-g.bar-2*scale)<=1,'Timing is not directly below the progress bar: '..detail)
    check(math.abs(active:GetX(true)-bar:GetX(true)-bar_width)<=1,'Timing does not align to the progress bar right edge: '..detail)
    check(active:GetW()>0 and math.abs(active:GetH()-18*scale)<=1,'Active timing hidden or taller than one row: '..detail)
    check(active:GetW()<=cap+1,'Auto-width timing exceeds its cap: '..detail)
    check(math.abs(active:GetX()-left)<=1,'Right-aligned native anchor convention changed: '..detail)
    local center_y=inset+g.body
    for index,name in ipairs({'MeterPrevious','MeterPlayPause','MeterNext'}) do
        local meter=SKIN:GetMeter(name)
        check(math.abs(meter:GetW()-g.transport_box)<=1 and math.abs(meter:GetH()-g.transport_box)<=1,'Transport target box changed: '..name)
        check(math.abs(meter:GetX(true)-(inset+g.transport_x-g.transport_pad+(index-1)*g.transport_step))<=1,'Transport is not centred right of the artwork: '..name)
        check(math.abs(meter:GetY(true)+meter:GetH()/2-center_y)<=1,'Transport is not centred on the panel lower border: '..name)
        check(meter:GetY(true)+meter:GetH()<=inset+g.rows_y+1,'Transport reaches the first queue row: '..name)
        check(meter:GetOption('Shape3'):find('Fill Color '..SKIN:GetVariable('AccentColor'),1,true)~=nil,'Transport face ignores AccentColor: '..name)
    end
    -- Measured, not asserted: the right-hand face against the visible time.
    -- That overlap belongs to the deferred transport x-axis decision.
    local face_left=SKIN:GetMeter('MeterNext'):GetX(true)+g.transport_pad
    local overlap_x=math.max(0,math.min(face_left+g.transport_size,active:GetX(true))-math.max(face_left,left))
    local overlap_y=math.max(0,math.min(center_y+g.transport_size/2,active:GetY(true)+active:GetH())-math.max(center_y-g.transport_size/2,active:GetY(true)))
    detail=detail..string.format(' nextFaceOverlap=%gx%g',overlap_x,overlap_y)
    return active:GetW(),detail
end
local function accordion(expanded, count, details)
    local width,height=dimensions(expanded,count)
    local g=media_geometry(expanded,count)
    local scale,inset=g.scale,g.inset
    local measure=assert(SKIN:GetMeasure('MeasureQueueStatus'))
    check(measure:GetOption('QueueCachePath')==SELF:GetOption('SyntheticCachePath'),'Synthetic cache not injected')
    check(measure:GetStringValue()=='Next '..count,'Queue display count wrong: '..measure:GetStringValue())
    check(SKIN:GetMeasure('MeasureMediaOptions'):GetStringValue()=='Queue','Accordion label wrong')
    -- The drawer's content: a column header and rule, then numbered rows on a
    -- fixed pitch. Hidden parts park at #Inset# so they cannot extend the window.
    -- A zero DividerThickness legitimately gives a shown delimiter no width,
    -- so a part counts as shown when it has any native extent.
    local function shown(meter) return meter:GetW()>0 or meter:GetH()>0 end
    for index=1,5 do
        local parts={'MeterQueueRow'..index,'MeterQueueNumber'..index,'MeterQueueDivider'..index}
        if expanded and index<=count then
            for _,name in ipairs(parts) do
                local meter=assert(SKIN:GetMeter(name))
                check(shown(meter),'Expanded row part hidden: '..name)
                check(math.abs(meter:GetY(true)-(inset+g.rows_y+18*(index-1)*scale))<=1,'Queue row is not on the drawer pitch: '..name)
                inside(name,width,height)
            end
            check(text(parts[1])=='Synthetic item '..index..(details and (' / Test artist '..index) or ''),'Row detail preference ignored')
            check(text(parts[2])==tostring(index),'Queue position digit changed')
            check(SKIN:GetMeter(parts[1]):GetOption('InlinePattern')==(details and ('Test artist '..index..'$') or '$^'),'Artist accent is not the literal row tail: '..index)
        else
            for _,name in ipairs(parts) do
                local meter=assert(SKIN:GetMeter(name))
                check(not shown(meter),'Collapsed or excess row part visible: '..name)
                check(math.abs(meter:GetY(true)-inset)<=1,'Hidden row part is not parked at the inset: '..name)
            end
            check(text(parts[1])=='','Collapsed or excess row retains text: '..index)
        end
    end
    for _,name in ipairs({'MeterQueueHeaderNumber','MeterQueueHeaderTrack','MeterQueueHeaderDivider','MeterQueueHeaderRule'}) do
        local meter=assert(SKIN:GetMeter(name))
        check(shown(meter)==expanded,'Queue header visibility does not follow expansion: '..name)
        if expanded then inside(name,width,height) end
    end
    check(text('MeterQueueHeaderTrack')=='Song / Artist','Queue column header changed')
    check(math.abs(SKIN:GetMeter('MeterQueueHeaderTrack'):GetY(true)-(inset+(expanded and g.queue_top or 0)))<=1,'Queue header is not at the drawer top, or not parked when closed')
    -- The retired inline footer stays hidden (MediaQueueHidden=1).
    check(SKIN:GetMeter('MeterQueueRule'):GetW()==0 and SKIN:GetMeter('MeterQueueStatus'):GetW()==0,'Retired queue footer is visible')
    local panel=SKIN:GetMeter('MeterPanel')
    check(math.abs(panel:GetY(true)+panel:GetH()-(inset+g.body))<=1,'Panel lower border does not follow the body')
    local sheet,toggle,label=SKIN:GetMeter('MeterQueueDrawer'),SKIN:GetMeter('MeterQueueToggle'),SKIN:GetMeter('MeterQueueHeading')
    if formula('#MediaQueueDrawer#')==1 then
        -- Tab: toggle then label, centred in the notch between the artwork
        -- column and the transport circles.
        local tab_x,tab_center=inset+g.content_x,inset+(g.tab_y+g.body)/2
        check(math.abs(sheet:GetY(true)+sheet:GetH()-(inset+g.drawer_bottom))<=1,
            string.format('Queue sheet bottom %g expected %g',sheet:GetY(true)+sheet:GetH(),inset+g.drawer_bottom))
        check(math.abs(toggle:GetX(true)-(tab_x+6*scale))<=1 and math.abs(toggle:GetW()-18*scale)<=1 and math.abs(toggle:GetH()-18*scale)<=1,'Queue toggle is not in the notch')
        check(math.abs(toggle:GetY(true)+toggle:GetH()/2-tab_center)<=1,'Queue toggle is not centred on the notch')
        check(math.abs(label:GetX(true)-(tab_x+30*scale))<=1 and math.abs(label:GetY(true)-tab_center)<=1,'Queue label is not in the notch')
        check(math.abs(label:GetW()-math.max(1,g.tab_right-g.content_x-34*scale))<=1,'Queue label is not clamped to the notch')
        check(toggle:GetX(true)+toggle:GetW()<=label:GetX(true),'Queue toggle and label hit targets overlap')
        for _,name in ipairs({'MeterQueueDrawer','MeterQueueToggle','MeterQueueHeading'}) do inside(name,width,height) end
    else
        -- Setup draws no sheet and cuts no notch, so its tab stays hidden.
        -- Its rows above still follow QueueExpanded, unbacked by a sheet;
        -- that is current behavior, recorded as open in Media.md.
        check(sheet:GetW()==0 and toggle:GetW()==0 and label:GetW()==0,'Queue tab shown without a drawer')
    end
    check(toggle:GetOption('Shape6'):find('(1-'..(expanded and '1' or '0')..')',1,true)~=nil,'Queue plus stroke ignores expansion')
    for _,name in ipairs({'MeterQueueHeading','MeterQueueToggle'}) do
        check(SKIN:GetMeter(name):GetOption('LeftMouseUpAction')=='[!CommandMeasure MeasureMediaOptions "ToggleQueue()"]','Queue action wiring changed: '..name)
    end
    for _,name in ipairs({'MeterBounds','MeterPanel','MeterHeading','MeterMediaIcon','MeterPlayerIcon'}) do inside(name,width,height) end
    header_row()
    check(SKIN:GetMeter('MeterMediaOptions'):GetW()==0,'Gear is not hidden initially')
    local enter,leave=SELF:GetOption('HoverEnter'),SELF:GetOption('HoverLeave')
    check(enter:find('!ShowMeter',1,true) and leave:find('!HideMeter',1,true),'Hover actions missing')
    SKIN:Bang(enter)
    check(SKIN:GetMeter('MeterMediaOptions'):GetW()>0,'Hover did not reveal gear')
    inside('MeterMediaOptions',width,height)
    SKIN:Bang(leave)
    check(SKIN:GetMeter('MeterMediaOptions'):GetW()==0,'Mouse leave did not hide gear')
end
local function command(measure, action) SKIN:Bang('!CommandMeasure',measure,action..'()') end
local function advance(next_stage, action)
    write(SELF:GetOption('StageFile'),tostring(next_stage)..'|'..tostring(previous_checks+checks))
    if action and kind:match('^QueueToggle') then
        -- The tab's two hit targets; the retired footer status is hidden.
        local meter=stage==3 and 'MeterQueueHeading' or 'MeterQueueToggle'
        SKIN:Bang(SKIN:GetMeter(meter):GetOption('LeftMouseUpAction'))
    elseif action then command('MeasureMediaOptions',action) else SKIN:Bang('!Refresh') end
end
local function settle(next_stage)
    -- A user click redraws after its action returns. Observe the next settled
    -- render without refreshing, so live reflow and controller state are tested.
    stage=next_stage; tick=0; done=false
end
local function accordion_stage()
    local prefs=preferences()
    if stage==1 then
        accordion(false,5,true); check(prefs.QueueExpanded=='0','Initial fixture changed')
        if kind:match('^QueueToggle') then artwork_bounds(false) end
        advance(2,'ToggleQueue')
    elseif stage==2 then
        accordion(true,5,true); check(prefs.QueueExpanded=='1','Expand preference not saved')
        if kind:match('^QueueToggle') then artwork_bounds(true) end
        SKIN:Bang('!WriteKeyValue','Variables','QueueRowLimit','3',SELF:GetOption('PreferencesPath'))
        SKIN:Bang('!WriteKeyValue','Variables','QueueShowDetails','0',SELF:GetOption('PreferencesPath'))
        advance(3)
    elseif stage==3 then
        accordion(true,3,false); check(prefs.QueueRowLimit=='3' and prefs.QueueShowDetails=='0','Presentation fixture did not reload')
        advance(4,'ToggleQueue')
    elseif stage==4 then
        accordion(false,3,false); check(prefs.QueueExpanded=='0','Collapse preference not saved')
        advance(5,'ToggleQueue')
    elseif stage==5 then
        accordion(true,3,false); check(prefs.QueueExpanded=='1','Second expand did not persist')
        if kind=='QueueTogglePlayer' then advance(6,'ToggleQueue') else return true end
    elseif stage==6 and kind=='QueueTogglePlayer' then
        accordion(false,3,false); check(prefs.QueueExpanded=='0','Final icon collapse did not persist')
        queue_transport_checks()
        return true
    else error('Unexpected accordion stage') end
    return false
end
local function settings_bounds(expanded)
    if expanded==nil then expanded=SKIN:GetVariable('QueueExpanded','0')=='1' end
    local width,height=dimensions(expanded,0)
    for _,name in ipairs({'MeterBounds','MeterPanel','MeterTitle','MeterClose','MeterWidthLabel','MeterWidthValue',
        'MeterQueueExpandedLabel','MeterQueueExpandedValue','MeterQueueRowsLabel','MeterQueueRowsValue','MeterQueueDetailsLabel',
        'MeterQueueDetailsValue','MeterQueuePollLabel','MeterQueuePollValue','MeterStatus','MeterQueueRule','MeterQueueHeading',
        'MeterSourceLabel','MeterSourceStart','MeterSourceStop','MeterSignIn','MeterStart','MeterStop','MeterRestart','MeterDisconnect','MeterLinksRule','MeterOpenQueue','MeterPlayerSetup','MeterHelp',
        'MeterUtilitySettingsNote','MeterUtilitySettingsGlobalLink','MeterDisplayHeading','MeterDisplayRule','MeterSamplingHeading',
        'MeterSamplingRule','MeterSourceRule','MeterSourceGuidance','MeterQueueGuidance','MeterLinksHeading'}) do inside(name,width,height) end
    local scale=SELF:GetNumberOption('ExpectedScale')
    local inset=math.floor(tonumber(SKIN:GetVariable('Gutter'))*scale/2+0.5)
    for _,stem in ipairs({'Width','QueueExpanded','QueueRows','QueueDetails','QueuePoll'}) do
        local label,value=SKIN:GetMeter('Meter'..stem..'Label'),SKIN:GetMeter('Meter'..stem..'Value')
        local numeric=stem=='Width' or stem=='QueueRows' or stem=='QueuePoll'
        local hidden=not expanded and (stem=='QueueRows' or stem=='QueueDetails')
        local meters={label,value}
        if numeric then for _,part in ipairs({'Decrease','Frame','Increase'}) do
            local meter=assert(SKIN:GetMeter('Meter'..stem..part));meters[#meters+1]=meter;inside('Meter'..stem..part,width,height)
        end end
        if hidden then
            for _,meter in ipairs(meters) do
                check(meter:GetW()==0 and meter:GetH()==0,'Collapsed setting retains a hit target: '..stem)
                check(meter:GetY(true)==inset,'Hidden settings anchor can enlarge window: '..stem)
            end
        elseif numeric then
            local decrease,frame,increase=unpack({meters[3],meters[4],meters[5]})
            check(label:GetX()+label:GetW()<=decrease:GetX(),'Settings label overlaps decrement: '..stem)
            check(decrease:GetX()+decrease:GetW()<=frame:GetX() and frame:GetX()+frame:GetW()<=increase:GetX(),'Stepper components overlap: '..stem)
            check(math.abs(increase:GetX()+increase:GetW()-decrease:GetX()-96*scale)<=1,'Stepper group width changed')
            check(math.abs(frame:GetW()-56*scale)<=1 and math.abs(frame:GetH()-20*scale)<=1,'Stepper frame bounds changed')
            check(value:GetH()==math.floor(18*scale) and math.abs(value:GetW()-56*scale)<=1,'Numeric center bounds changed')
            check(math.abs(value:GetY()-frame:GetY()-scale)<=1 and value:GetY()==decrease:GetY(),'Stepper text not vertically aligned')
            check(frame:GetOption('Shape'):find(SKIN:GetVariable('GraphBackgroundColor'),1,true)~=nil,'Stepper frame not shaded')
            check(value:GetOption('FontColor')==SKIN:GetVariable('TextColor'),'Numeric field ignores body color')
            check(decrease:GetOption('FontColor')==SKIN:GetVariable('AccentColor'),'Stepper arrows ignore Accent1')
            check(frame:GetOption('LeftMouseUpAction')==value:GetOption('LeftMouseUpAction'),'Frame input action differs')
        else
            check(label:GetW()>0 and value:GetW()>0,'Visible settings control hidden: '..stem)
            check(label:GetX()+label:GetW()<=value:GetX(),'Settings label overlaps field: '..stem)
            local field_height=math.floor(18*scale)+2*math.floor(scale)
            check(value:GetH()==field_height,'Toggle field height differs from native shared dimensions')
        end
        if not numeric then check(value:GetOption('SolidColor')==SKIN:GetVariable('GraphBackgroundColor'),'Toggle field is not shaded') end
        check(label:GetOption('SolidColor','')=='','Settings label should not have a row background')
        check(label:GetOption('LeftMouseUpAction')==value:GetOption('LeftMouseUpAction'),'Settings label action differs from field')
    end
    local shift=expanded and 0 or 56
    for name,y in pairs({MeterSamplingHeading=218,MeterQueuePollValue=245,MeterStatus=272,
        MeterSourceLabel=302,MeterSourceStart=339,MeterQueueHeading=386,MeterSignIn=423,MeterLinksHeading=498}) do
        local meter=SKIN:GetMeter(name)
        check(meter:GetW()>0 and meter:GetH()>0,'Recovery/sampling control hidden: '..name)
        check(math.abs(meter:GetY(true)-(inset+(y-shift)*scale))<=1,'Dependent settings did not reflow: '..name)
    end
    check(SKIN:GetMeter('MeterClose'):GetOption('LeftMouseUpAction')=='[!DeactivateConfig]','Close action changed')
    check(SKIN:GetMeter('MeterOpenQueue'):GetOption('LeftMouseUpAction')=='[!ActivateConfig "Parallax\\Media\\Queue" "Queue.ini"]','Queue navigation changed')
    check(SKIN:GetMeter('MeterPlayerSetup'):GetOption('LeftMouseUpAction')=='[!ActivateConfig "Parallax\\Media" "Setup.ini"]','Setup navigation changed')
    check(SKIN:GetMeter('MeterHelp'):GetOption('LeftMouseUpAction'):match('Modules\\Media\\Queue\\README%.md"%]$')~=nil,'Help action changed')
    local edit=SELF:GetOption('EditSettingsAction','')
    check(edit:match('User\\Media%.inc"%]$')~=nil,'Manual settings-file recovery action missing')
end
local function settings_action(expression) SKIN:Bang('!CommandMeasure','MeasureMediaSettings',expression) end
local function settings_count(name) return tonumber(SKIN:GetVariable(name,'0')) end
local function unchanged(action,message)
    local before=read(SELF:GetOption('PreferencesPath'))
    local writes,refreshes=settings_count('FixtureSettingsWrites'),settings_count('FixtureSettingsRefreshes')
    action()
    check(read(SELF:GetOption('PreferencesPath'))==before,message..': preference bytes changed')
    check(settings_count('FixtureSettingsWrites')==writes and settings_count('FixtureSettingsRefreshes')==refreshes,message..': wrote or refreshed')
    check(SKIN:GetVariable('FixtureInputSentinel')=='unchanged','Input data executed an action')
end
local function input_result(index,status)
    SKIN:Bang('!CommandMeasure','MeasureMediaSettingsInput','Select('..index..')')
    SKIN:Bang('!UpdateMeasure','MeasureMediaSettingsInput')
    SKIN:Bang('!SetVariable','FixtureInputStatus',status or 1)
    settings_action('CommitNumberInput()')
end
local function begin_number(key)
    local before=settings_count('FixtureInputRuns')
    settings_action("BeginNumberInput('"..key.."')")
    check(settings_count('FixtureInputRuns')==before+1,'Explicit numeric click did not request one input: '..key)
    local parameter=SKIN:GetMeasure('MeasureMediaSettingsInput'):GetOption('Parameter')
    local low,high=key=='QueuePollSeconds' and 30 or 1,key=='Columns' and 2 or key=='QueueRowLimit' and 5 or 150
    check(parameter:find('-Key UtilityNumber -Minimum '..low..' -Maximum '..high..' -DecimalPlaces 0',1,true)~=nil,'Typed input bounds or helper key wrong')
    check(parameter:match(' %-Initial "%d+" %-X %-?%d+ %-Y %-?%d+ %-Width %d+ %-Height %d+ %-Scale [%d%.]+$')~=nil,'Typed arguments are not bounded scalar data')
end
local function settings_stage()
    settings_bounds(stage~=1 and stage~=5 and stage~=6 and stage~=9)
    local prefs=preferences()
    if stage==1 then
        check(prefs.Columns=='2' and prefs.QueuePollSeconds=='30','Settings fixture changed on load')
        check(text('MeterWidthValue')=='2' and text('MeterQueueExpandedValue')=='Collapsed','Initial labels wrong')
        check(settings_count('FixtureInputRuns')==0 and settings_count('FixtureSettingsWrites')==0,'Settings auto-started input or wrote on load')
        unchanged(function()
            for _,action in ipairs({"StepNumber('Columns',1)","StepNumber('QueuePollSeconds',-1)","StepNumber('QueueRowLimit',-1)",
                "BeginNumberInput('QueueRowLimit')","StepNumber('Scale',1)","StepNumber('Columns',2)","StepNumber('Columns','1')",'CommitNumberInput()'}) do settings_action(action) end
        end,'Bounds/hidden/invalid action')
        check(settings_count('FixtureInputRuns')==0,'Hidden field opened input')
        SKIN:Bang(SKIN:GetMeter('MeterWidthDecrease'):GetOption('LeftMouseUpAction'))
        command('MeasureMediaSettings','ToggleQueueExpanded')
        SKIN:Bang(SKIN:GetMeter('MeterQueueRowsDecrease'):GetOption('LeftMouseUpAction'))
        SKIN:Bang(SKIN:GetMeter('MeterQueuePollIncrease'):GetOption('LeftMouseUpAction'))
        command('MeasureMediaSettings','ToggleQueueDetails')
        prefs=preferences()
        check(prefs.Columns=='1' and prefs.QueueExpanded=='1' and prefs.QueueRowLimit=='4' and prefs.QueueShowDetails=='0' and prefs.QueuePollSeconds=='31','Arrows must step exactly one')
        check(settings_count('FixtureSettingsWrites')==5 and settings_count('FixtureSettingsRefreshes')==10,'Explicit edits did not write once and refresh only fixed targets')
        check(text('MeterStatus')=='Use Restart to apply interval.','Interval lacks explicit restart reminder')
        settle(2)
    elseif stage==2 then
        begin_number('Columns')
        unchanged(function()
            local runs=settings_count('FixtureInputRuns')
            settings_action("BeginNumberInput('QueuePollSeconds')")
            settings_action("StepNumber('Columns',1)")
            input_result(1,0)
            check(settings_count('FixtureInputRuns')==runs,'Duplicate editor launched')
        end,'Pending/running input')
        input_result(1);check(preferences().Columns=='2','Valid typed column not saved')
        for _,index in ipairs({4,5,6,7,8,9,13,15}) do
            begin_number('QueuePollSeconds')
            unchanged(function() input_result(index) end,'Invalid/cancel output '..index)
        end
        begin_number('QueuePollSeconds');input_result(3)
        check(preferences().QueuePollSeconds=='150','Upper typed endpoint not saved')
        unchanged(function() settings_action("StepNumber('QueuePollSeconds',1)") end,'Upper bound')
        begin_number('QueuePollSeconds');unchanged(function() input_result(3) end,'Same numeric input')
        begin_number('QueuePollSeconds');input_result(10)
        check(preferences().QueuePollSeconds=='30','CRLF lower endpoint not saved')
        begin_number('QueuePollSeconds');SKIN:Bang('!SetVariable','FixtureInputAge','301')
        unchanged(function() input_result(11) end,'Expired request');SKIN:Bang('!SetVariable','FixtureInputAge','0')
        begin_number('QueuePollSeconds');SKIN:Bang('!SetVariable','FixtureInputAge','-1')
        unchanged(function() input_result(11) end,'Clock rollback');SKIN:Bang('!SetVariable','FixtureInputAge','0')
        begin_number('QueuePollSeconds');unchanged(function() input_result(11,103) end,'Failed process')
        begin_number('QueueRowLimit');input_result(12)
        check(preferences().QueueRowLimit=='1','Row lower endpoint failed')
        unchanged(function() settings_action("StepNumber('QueueRowLimit',-1)") end,'Row lower bound')
        begin_number('QueueRowLimit');input_result(16)
        check(preferences().QueueRowLimit=='5','Row upper endpoint failed')
        unchanged(function() settings_action("StepNumber('QueueRowLimit',1)") end,'Row upper bound')
        begin_number('QueuePollSeconds')
        SKIN:Bang('!WriteKeyValue','Variables','QueuePollSeconds','45',SELF:GetOption('PreferencesPath'))
        unchanged(function() input_result(11) end,'Fresh saved value changed')
        SKIN:Bang('!WriteKeyValue','Variables','QueueRowLimit','2',SELF:GetOption('PreferencesPath'))
        advance(3)
    elseif stage==3 then
        check(prefs.QueueRowLimit=='2' and prefs.QueuePollSeconds=='45','Custom values did not reload')
        check(text('MeterQueueRowsValue')=='2' and text('MeterQueuePollValue')=='45','Custom numbers not rendered')
        settings_action("StepNumber('QueueRowLimit',1)")
        check(preferences().QueueRowLimit=='3','Custom row step is not one')
        local raw=read(SELF:GetOption('PreferencesPath'))
        if raw:sub(1,2)=='\255\254' then raw=raw:sub(3):gsub('(.).','%1') end
        local changed,count=raw:gsub('QueuePollSeconds=[^\r\n]+','QueuePollSeconds=(60*2)')
        check(count==1,'Cannot install raw expression fixture');write(SELF:GetOption('PreferencesPath'),changed)
        unchanged(function() settings_action("StepNumber('QueuePollSeconds',1)") end,'Saved formula arrow')
        begin_number('QueuePollSeconds');input_result(10)
        check(preferences().QueuePollSeconds=='30','Typed displayed default did not replace formula')
        SKIN:Bang('!WriteKeyValue','Variables','QueuePollSeconds','030',SELF:GetOption('PreferencesPath'))
        unchanged(function() settings_action("StepNumber('QueuePollSeconds',-1)") end,'Leading-zero lower bound')
        begin_number('QueuePollSeconds');unchanged(function() input_result(10) end,'Leading-zero numeric no-op')
        settings_action("StepNumber('QueuePollSeconds',1)")
        check(preferences().QueuePollSeconds=='31','Leading-zero literal not stepped canonically')
        begin_number('QueueRowLimit')
        command('MeasureMediaSettings','ToggleQueueExpanded')
        unchanged(function() input_result(2) end,'Now-hidden/local revision changed')
        command('MeasureMediaSettings','ToggleQueueExpanded')
        begin_number('QueuePollSeconds');input_result(11)
        settings_action("StepNumber('QueuePollSeconds',-1)")
        check(preferences().QueuePollSeconds=='119','Typed interior followed by arrow wrong')
        check(text('MeterStatus')=='Use Restart to apply interval.','Toggle lost restart reminder')
        check(SKIN:GetMeter('MeterSignIn'):GetOption('LeftMouseUpAction'):find('"-PollSeconds" "119"',1,true)~=nil,'Visible sign-in action does not use saved interval')
        check(SKIN:GetMeter('MeterStart'):GetOption('LeftMouseUpAction'):find("ProviderControl('Queue','Start')",1,true)~=nil,'Start action bypasses the hidden provider controller')
        check(SKIN:GetMeter('MeterRestart'):GetOption('LeftMouseUpAction'):find("ProviderControl('Queue','Restart')",1,true)~=nil,'Restart action bypasses the hidden provider controller')
        settings_action("ProviderControl('Queue','Start')")
        check(SKIN:GetMeasure('MeasureMediaQueueControl'):GetOption('Parameter'):find('-Command "Start" -PollSeconds "119" -Quiet',1,true)~=nil,'Hidden start command does not use saved interval')
        settings_action("ProviderControl('Queue','Restart')")
        check(SKIN:GetMeasure('MeasureMediaQueueControl'):GetOption('Parameter'):find('-Command "Restart" -PollSeconds "119" -Quiet',1,true)~=nil,'Hidden restart command does not use saved interval')
        advance(4)
    elseif stage==4 then
        check(prefs.QueueRowLimit=='3' and prefs.QueuePollSeconds=='119','Typed and stepped values not retained across reload')
        check(text('MeterQueueRowsValue')=='3' and text('MeterQueuePollValue')=='119','Next preset labels not reloaded')
        settings_expanded_height=SKIN:GetH()
        SKIN:Bang(SKIN:GetMeter('MeterQueueExpandedLabel'):GetOption('LeftMouseUpAction'))
        prefs=preferences()
        check(prefs.QueueExpanded=='0' and prefs.QueueRowLimit=='3' and prefs.QueueShowDetails=='0','Collapse discarded saved display values')
        settle(5)
    elseif stage==5 then
        check(settings_expanded_height-SKIN:GetH()==math.floor(56*SELF:GetNumberOption('ExpectedScale')+0.5),'Collapse did not reclaim 56 logical pixels')
        advance(6)
    elseif stage==6 then
        check(prefs.QueueExpanded=='0' and prefs.QueueRowLimit=='3' and prefs.QueueShowDetails=='0','Collapsed preferences did not survive reopen')
        check(text('MeterQueueRowsValue')=='3' and text('MeterQueueDetailsValue')=='Hidden','Collapsed settings discarded value labels')
        SKIN:Bang(SKIN:GetMeter('MeterQueueExpandedValue'):GetOption('LeftMouseUpAction'))
        settle(7)
    elseif stage==7 then
        check(text('MeterQueueRowsValue')=='3' and text('MeterQueueDetailsValue')=='Hidden','Expand failed to restore previous display choices')
        advance(8)
    elseif stage==8 then
        check(prefs.QueueExpanded=='1' and prefs.QueueRowLimit=='3' and prefs.QueueShowDetails=='0','Expanded values did not survive reopen')
        -- Retain one collapsed and one expanded endpoint capture.
        if SELF:GetNumberOption('ExpectedWidth')==180 then
            command('MeasureMediaSettings','ToggleQueueExpanded')
            settle(9)
        else
            return true
        end
    elseif stage==9 then
        return true
    else error('Unexpected settings stage') end
    return false
end
local function sync_stage()
    local expected=stage==2 and 'Expanded' or 'Collapsed'
    accordion(stage==2,5,true)
    local result=read(SELF:GetOption('SyncLabelFile'))
    local label,side_checks=result:match('^(%a+)|(%d+)$')
    check(label==expected,'Open Settings did not synchronize label/geometry: expected '..expected..', got '..result)
    check(tonumber(side_checks or 0)>0,'Settings synchronization omitted native geometry checks')
    checks=checks+tonumber(side_checks)
    if stage<3 then advance(stage+1,'ToggleQueue') else return true end
    return false
end
local function probe_names()
    if kind:match('^QueueToggle') then return {'MeterQueueHeading'} end
    if kind:match('^TitleRow') then
        if is_settings() then return {'MeterTitle','MeterClose'} end
        if kind:match('Queue$') then return {'MeterHeading','MeterQueueStatus'} end
        if kind:match('Setup$') then return {'MeterHeading','MeterSetupStatus'} end
        return {'MeterHeading'}
    end
    if kind:match('^Identity') then return {'MeterHeading'} end
    if is_settings() then return {'MeterTitle','MeterQueueHeading','MeterQueuePollLabel','MeterQueuePollValue',
        'MeterStatus','MeterDisconnect','MeterPlayerSetup','MeterClose','MeterSourceLabel','MeterSourceStart','MeterSourceStop',
        'MeterUtilitySettingsNote','MeterUtilitySettingsGlobalLink','MeterSourceGuidance','MeterQueueGuidance'} end
    local names={'MeterHeading','MeterQueueHeading','MeterQueueHeaderTrack','MeterQueueRow1'}
    local other=kind:find('Player',1,true) and {'MeterTrackTitle','MeterArtist','MeterAlbum','MeterTiming'} or
        {'MeterSetupInstructions','MeterDesktopNote','MeterWNPDocs','MeterLoadPlayer'}
    for _,name in ipairs(other) do names[#names+1]=name end
    return names
end
local function prepare_probes()
    local names=probe_names()
    if kind:find('Player',1,true) and not kind:match('^Identity') and not kind:match('^TitleRow') and not kind:match('^QueueToggle') then names[#names+1]='MeterTimingUnavailable' end
    for _,name in ipairs(names) do
        local target=assert(SKIN:GetMeter(name))
        check(SKIN:GetMeter('Probe'..name)~=nil,'Missing glyph probe '..name)
        if name=='MeterTiming' then
            SKIN:Bang('!SetOption','ProbeMeterTiming','Text',SKIN:GetMeasure('MeasurePosition'):GetStringValue()..' / '..SKIN:GetMeasure('MeasureDuration'):GetStringValue())
        end
        for option,default in pairs({FontFace='Arial',FontSize='10',FontWeight='400',StringStyle='Normal',StringCase='None',CharacterSpacing='0'}) do
            SKIN:Bang('!SetOption','Probe'..name,option,target:GetOption(option,default))
        end
    end
    if not is_settings() then
        local target=SKIN:GetMeter('MeterQueueStatus')
        for index=1,5 do
            for option,default in pairs({FontFace='Arial',FontSize='10',FontWeight='400',StringStyle='Normal',StringCase='None',CharacterSpacing='0'}) do
                SKIN:Bang('!SetOption','ProbeStatus'..index,option,target:GetOption(option,default))
            end
        end
    end
    SKIN:Bang('!UpdateMeterGroup','TypographyProbes')
end
-- Full-width fit of the title is asserted everywhere the fixture states fit:
-- the compact "Media:" label was introduced to make room at 12 pt. Double
-- width below 220 at the maximum title size still ends in an ellipsis (an open
-- item), so that shortfall is measured and reported rather than failed.
local function heading_must_fit()
    return not (SELF:GetNumberOption('ExpectedColumns')==2 and SELF:GetNumberOption('ExpectedWidth')<220
        and SELF:GetOption('TypographyProfile','default')=='max')
end
local function glyph_fit(name, target, w, h)
    local detail=string.format('%s=%dx%d/%dx%d',name,w,h,target:GetW(),target:GetH())
    local panel=not is_settings()
    if panel and name=='MeterQueueHeading' and target:GetW()==0 then
        -- Setup cuts no notch, so its tab label is hidden rather than clipped.
        check(formula('#MediaQueueDrawer#')==0,'Queue tab label hidden while the drawer is enabled')
        return detail..' hidden'
    end
    check(w>0 and h>0 and h<=target:GetH(),'Native glyph clipping: '..detail)
    -- The notch label is clamped to whatever the transport leaves of the tab,
    -- degrading to the icon alone at narrow widths; report, do not fail.
    local reported=panel and (name=='MeterQueueHeading' or name=='MeterHeading' and not heading_must_fit())
    if reported then
        if w>target:GetW() then fit_report[#fit_report+1]=string.format('%s clips %dpx (%d/%d)',name,w-target:GetW(),w,target:GetW()) end
    else check(w<=target:GetW(),'Native glyph clipping: '..detail) end
    return detail
end
local function missing_time()
    if not kind:find('Player',1,true) then return end
    local duration=SKIN:GetMeasure('MeasureDuration')
    local original=duration:GetOption('Formula')
    check(duration:GetOption('Measure')=='Calc','Missing-time fixture must be inert')
    SKIN:Bang('!SetOption','MeasureDuration','Formula','0')
    SKIN:Bang('!UpdateMeasure','MeasureDuration')
    SKIN:Bang('!UpdateMeasure','MeasureMediaUI')
    SKIN:Bang('!UpdateMeterGroup','MediaTimeline')
    SKIN:Bang('!UpdateMeterGroup','MediaDynamic')
    local target,probe=SKIN:GetMeter('MeterTimingUnavailable'),SKIN:GetMeter('ProbeMeterTimingUnavailable')
    check(target:GetW()>0 and SKIN:GetMeter('MeterTiming'):GetW()==0,'Unavailable playback time state not shown')
    check(text('MeterTimingUnavailable')=='-- / --','Unavailable time label changed')
    probe:Show();local w,h=probe:GetW(),probe:GetH();probe:Hide()
    check(w>0 and h>0 and w<=target:GetW() and h<=target:GetH(),string.format('Missing-time glyph clipping %dx%d/%dx%d',w,h,target:GetW(),target:GetH()))
    check(target:GetOption('StringAlign')=='Right','Unavailable time is not right aligned')
    local _,detail=transport_layout('MeterTimingUnavailable')
    timing_report=timing_report..(timing_report=='' and '' or '; ')..detail
    SKIN:Bang('!SetOption','MeasureDuration','Formula',original)
    SKIN:Bang('!UpdateMeasure','MeasureDuration')
    SKIN:Bang('!UpdateMeasure','MeasureMediaUI')
    SKIN:Bang('!UpdateMeterGroup','MediaTimeline')
    SKIN:Bang('!UpdateMeterGroup','MediaDynamic')
    check(SKIN:GetMeter('MeterTiming'):GetW()>0 and target:GetW()==0,'Synthetic playback time did not restore')
end
local function typography()
    local info={}
    if not is_settings() then
        local statuses={}
        for index=1,5 do
            local probe=assert(SKIN:GetMeter('ProbeStatus'..index))
            probe:Show(); local w,h=probe:GetW(),probe:GetH(); probe:Hide()
            statuses[#statuses+1]=probe:GetOption('Text')..'='..w..'x'..h
        end
        glyph_report='status widths: '..table.concat(statuses,',')
    end
    for _,name in ipairs(probe_names()) do
        local target,probe=assert(SKIN:GetMeter(name)),assert(SKIN:GetMeter('Probe'..name))
        probe:Show(); local w,h=probe:GetW(),probe:GetH(); probe:Hide()
        info[#info+1]=glyph_fit(name,target,w,h)
        if name=='MeterQueueHeaderTrack' and kind:find('Player',1,true) and target:GetW()>0 then
            -- InlineQueueGeometry.inc lets the column header sit behind the
            -- transport circles on the premise that its short text ends left
            -- of them. Measured, not asserted: that premise is the open
            -- transport x-axis question.
            local g=media_geometry(true,5)
            local left,right=SKIN:GetMeter('MeterPrevious'):GetX(true)+g.transport_pad,SKIN:GetMeter('MeterNext'):GetX(true)+g.transport_pad+g.transport_size
            local center=g.inset+g.body
            local overlap_x=math.max(0,math.min(target:GetX(true)+w,right)-math.max(target:GetX(true),left))
            local overlap_y=math.max(0,math.min(target:GetY(true)+target:GetH(),center+g.transport_size/2)-math.max(target:GetY(true),center-g.transport_size/2))
            if overlap_x>0 and overlap_y>0 then
                fit_report[#fit_report+1]=string.format('queue header text under transport faces %gx%gpx',overlap_x,overlap_y)
            end
        end
    end
    glyph_report=table.concat(info,',')
    local function color(meter,variable)
        check(SKIN:GetMeter(meter):GetOption('FontColor')==SKIN:GetVariable(variable),meter..' ignores '..variable)
    end
    color(is_settings() and 'MeterTitle' or 'MeterHeading','TitleTextColor')
    color('MeterQueueHeading',is_settings() and 'AccentColor' or 'HeaderTextColor')
    if is_settings() then
        color('MeterQueuePollLabel','TextColor'); color('MeterStatus','TextColor')
        for _,name in ipairs({'MeterWidthValue','MeterQueueExpandedValue','MeterQueueRowsValue','MeterQueueDetailsValue','MeterQueuePollValue'}) do color(name,'TextColor') end
        color('MeterStart','AccentColor'); color('MeterStop','AccentColor2'); color('MeterPlayerSetup','AccentColor2')
        for _,name in ipairs({'MeterDisplayHeading','MeterSamplingHeading','MeterSourceLabel','MeterLinksHeading'}) do color(name,'AccentColor') end
        color('MeterSourceStart','AccentColor'); color('MeterSourceStop','AccentColor2')
    else
        color('MeterQueueRow1','TextColor')
        check(SKIN:GetMeter('MeterQueueRow1'):GetOption('InlineSetting')=='Color | '..SKIN:GetVariable('AccentColor2'),'Queue artist accent ignores AccentColor2')
        if kind:find('Player',1,true) then
            color('MeterArtist','TextColor'); color('MeterAlbum','TextColor')
            -- Accent faces carry background-colored glyphs (Media.lua, provisional).
            local previous=SKIN:GetMeter('MeterPrevious')
            check(previous:GetOption('Shape3'):find('Fill Color '..SKIN:GetVariable('AccentColor'),1,true)~=nil,'Transport face ignores AccentColor')
            check(previous:GetOption('LucideTransportStroke'):find('Stroke Color '..SKIN:GetVariable('BackgroundColor'),1,true)~=nil,'Transport glyph ignores BackgroundColor')
        else
            color('MeterSetupStatus','WarningColor'); color('MeterDesktopNote','TextColor')
            color('MeterLoadPlayer','AccentColor'); color('MeterWNPDocs','AccentColor2')
        end
    end
    local rule=SKIN:GetMeter(is_settings() and 'MeterQueueRule' or 'MeterQueueHeaderRule'):GetOption('Shape')
    check(rule:find('Stroke Color '..SKIN:GetVariable('DividerColor'),1,true)~=nil,'Divider color override not inherited')
end
local function typography_stage()
    preferences()
    if is_settings() then settings_bounds() else accordion(true,5,true) end
    if kind:find('Player',1,true) then
        check(SKIN:GetMeasure('MeasureConnection'):GetOption('Measure')=='Calc','Player fixture contains non-synthetic connection')
        check(SKIN:GetMeasure('MeasureMediaUI'):GetStringValue()=='Playing','Synthetic player not connected')
        check(SKIN:GetMeter('MeterTrackTitle'):GetW()>0,'Synthetic track row hidden')
        check(SKIN:GetMeter('MeterProgress'):GetW()>0,'Synthetic timeline hidden')
        check(SKIN:GetMeasure('MeasureMediaSource'):GetOption('Measure')=='String','Real source reader loaded in UI fixture')
        check(SKIN:GetMeasure('MeasureSourceArtist'):GetOption('Measure')=='String','Raw artist fixture is not synthetic')
        check(SKIN:GetMeter('MeterHeading'):GetOption('MeasureName')=='MeasureMediaHeader' and SKIN:GetMeter('MeterPlayerName')==nil
            and SKIN:GetMeter('MeterConnection')==nil,'Title binding, removed player row or removed playback status changed')
        check(SKIN:GetMeasure('MeasureMediaSource'):GetStringValue()=='Spotify','Synthetic Spotify source was not retained')
        check(SKIN:GetMeasure('MeasurePlayer'):GetStringValue()=='Windows Media Session','Raw player fixture does not distinguish source binding')
    end
    return true
end
artwork_bounds=function(expanded)
    local g=media_geometry(expanded,5)
    local scale,inset,padding,wide=g.scale,g.inset,g.padding,g.wide
    local art_x,art_y,art_size=inset+g.cover_x,inset+g.cover_y,g.cover
    local surface_y=inset+g.offset
    local content_x=inset+g.content_x
    local width,height=dimensions(expanded,5)
    local panel=SKIN:GetMeter('MeterPanel')
    check(math.abs(panel:GetX(true)-(inset+g.surface_x))<=1,'Surface left offset wrong')
    check(math.abs(panel:GetY(true)-surface_y)<=1,'Surface top offset wrong')
    check(math.abs(panel:GetY(true)+panel:GetH()-(inset+g.body))<=1,'Surface bottom does not follow the rendered body')
    check(math.abs(panel:GetX(true)+panel:GetW()-(width-inset))<=1,'Surface right edge changed pitch')
    check(math.abs(SKIN:GetMeter('MeterHeading'):GetY(true)-(surface_y+15*scale))<=1,'Title center does not follow the inset surface')
    local function art(name,visible)
        local meter=assert(SKIN:GetMeter(name))
        if visible then
            check(math.abs(meter:GetX(true)-art_x)<=1 and math.abs(meter:GetY(true)-art_y)<=1,name..' position changed')
            check(meter:GetW()==art_size and meter:GetH()==art_size,name..' is not the expected square')
            inside(name,width,height)
        else check(meter:GetW()==0,name..' unexpectedly visible') end
    end
    local player=kind:find('Player',1,true)~=nil
    art('MeterArtworkPlaceholder',wide and not player)
    check((SKIN:GetMeter('MeterArtworkLabel'):GetW()>0)==(wide and not player),'Wide artwork underlay label visibility wrong')
    local names={'MeterMediaIcon','MeterPlayerIcon','MeterHeading'}
    header_row()
    if kind:find('Player',1,true) then
        local missing=kind=='ArtworkPlayerMissing'
        local cover=SKIN:GetMeasure('MeasureCover')
        check(cover:GetOption('Measure')=='String','Artwork fixture is not synthetic')
        check(missing and cover:GetStringValue()=='' or not missing and cover:GetStringValue():match('synthetic%-cover%.png$'),'Artwork fixture state incorrect')
        check(SKIN:GetMeasure('MeasureMediaUI'):GetStringValue()=='Playing','Missing artwork changed playback state')
        check(SKIN:GetMeasure('MeasureMediaSource'):GetOption('Measure')=='String' and SKIN:GetMeasure('MeasureMediaSource'):GetStringValue()=='Spotify','Synthetic source replaced or changed')
        check(SKIN:GetMeasure('MeasureSourceArtist'):GetOption('Measure')=='String','Raw artist fixture not synthetic')
        art('MeterCoverPlaceholder',true)
        art('MeterCoverMask',true)
        art('MeterCoverFrame',true)
        art('MeterCover',not missing)
        check(SKIN:GetMeter('MeterCover'):GetOption('Container')=='MeterCoverMask','Artwork does not use the rounded mask')
        check(SKIN:GetMeter('MeterCoverMask'):GetOption('Group',''):find('MediaTrack',1,true)==nil,'Mask can be hidden by track state')
        check((SKIN:GetMeter('MeterCoverLabel'):GetW()>0)==missing and text('MeterCoverLabel')=='N/A','N/A label must show only when artwork is missing')
        check(SKIN:GetMeter('MeterCoverLabel'):GetOption('ToolTipText')=='No artwork available.','Missing artwork tooltip lost')
        check(SKIN:GetMeter('MeterCover'):GetOption('PreserveAspectRatio')=='2','Artwork crop behavior changed')
        check(SKIN:GetMeter('MeterConnection')==nil,'Removed playback status remains visible')
        for _,name in ipairs({'MeterTrackTitle','MeterArtist','MeterAlbum','MeterTiming','MeterPrevious','MeterPlayPause','MeterNext','MeterProgress'}) do names[#names+1]=name end
        local progress=SKIN:GetMeter('MeterProgress')
        check(math.abs(progress:GetX(true)-content_x)<=1,'Progress does not start after the artwork')
        check(math.abs(progress:GetX(true)+progress:GetW()-(width-inset-padding))<=1,'Progress does not end at content edge')
        local bar_height=math.max(1,math.floor(SELF:GetNumberOption('ExpectedBarThickness',6)*scale+0.5))
        check(progress:GetH()==bar_height,'Progress bar ignores rounded shared thickness')
        check(tonumber(SKIN:GetVariable('DataBarThickness'))==SELF:GetNumberOption('ExpectedBarThickness',6),'Thickness fixture preference changed')
        local album=SKIN:GetMeter('MeterAlbum')
        check(progress:GetY(true)>=album:GetY(true)+album:GetH()/2+2*scale-1,'Bar overlaps metadata')
        local title=SKIN:GetMeter('MeterTrackTitle')
        -- Metadata shares the content column at double width; compact rows
        -- start after the 36px thumbnail beside them.
        local metadata_x=inset+(wide and art_size+8*scale or padding+54*scale)
        check(math.abs(title:GetX(true)-(metadata_x+20*scale))<=1,'Track title is not clear of its icon')
        local icon_shapes={}
        for row,pair in ipairs({{'MeterSongIcon','MeterTrackTitle'},{'MeterArtistIcon','MeterArtist'},{'MeterAlbumIcon','MeterAlbum'}}) do
            local icon,label=SKIN:GetMeter(pair[1]),SKIN:GetMeter(pair[2])
            names[#names+1]=pair[1]
            check(icon:GetOption('Meter')=='Shape' and icon:GetOption('Group')=='MediaTrack','Metadata icon is not a track shape')
            check(math.abs(icon:GetW()-14*scale)<=1 and math.abs(icon:GetH()-14*scale)<=1,'Metadata icon dimensions wrong')
            check(math.abs(icon:GetX(true)-metadata_x)<=1 and icon:GetX(true)+icon:GetW()<=label:GetX(true)-5*scale+1,'Metadata icon overlaps text')
            local expected_y=surface_y+(30+(row-1)*24)*scale
            check(label:GetOption('StringAlign')=='LeftCenter','Metadata text is not vertically centered')
            check(math.abs(label:GetY(true)-(expected_y+12*scale))<=1 and math.abs(icon:GetY(true)-(expected_y+5*scale))<=1,'Metadata row alignment wrong')
            check(math.abs(label:GetY(true)-icon:GetY(true)-icon:GetH()/2)<=1,'Metadata icon and text centers differ')
            local font_size=tonumber(label:GetOption('FontSize')) or SKIN:ParseFormula(label:GetOption('FontSize'))
            check(math.abs(font_size-tonumber(SKIN:GetVariable('FontSize'))*scale)<0.001,'Metadata does not inherit body font size')
            check(math.abs(label:GetH()-24*scale)<=1,'Enlarged metadata row height wrong')
            check(math.abs(label:GetW()-(width-inset-padding-metadata_x-20*scale))<=1,'Artwork shrink changed metadata width')
            local fingerprint=icon:GetOption('Shape')..icon:GetOption('Shape2','')..icon:GetOption('Shape3','')
            check(not icon_shapes[fingerprint],'Metadata icons are duplicates')
            icon_shapes[fingerprint]=true
        end
        local timing=SKIN:GetMeter('MeterTiming')
        local _,detail=transport_layout('MeterTiming')
        timing_report=timing_report..(timing_report=='' and '' or '; ')..detail
        check(timing:GetOption('StringAlign')=='Right','Playback time is not right aligned')
        check(math.abs(timing:GetX(true)-(width-inset-padding))<=1,'Playback time right edge wrong')
        check(math.abs(timing:GetY(true)-progress:GetY(true)-bar_height-2*scale)<=1,'Playback time baseline wrong')
        check(SKIN:GetMeter('MeterPrevious'):GetY(true)>progress:GetY(true)+bar_height,'Transport does not sit below the bar')
    else
        check(SKIN:GetMeasure('MeasureMediaSource')==nil,'Setup loaded a source reader')
        for _,name in ipairs({'MeterSetupStatus','MeterSetupInstructions','MeterDesktopNote','MeterWNPDocs','MeterLoadPlayer'}) do names[#names+1]=name end
    end
    for _,name in ipairs(names) do
        local meter=SKIN:GetMeter(name)
        inside(name,width,height)
        if wide then
            local left=meter:GetX(true)
            if meter:GetOption('StringAlign','Left'):match('^Center') then left=left-meter:GetW()/2 end
            check(left>=art_x+art_size+8*scale-1,name..' intrudes into artwork gap')
        end
    end
    -- The queue is the drawer's content: indented by the sheet's 8px padding
    -- from the surface, ending 8px inside the content column's right edge, and
    -- starting 4px below whichever of the artwork and the panel hangs lower.
    local queue_x=inset+g.surface_x+8*scale
    local queue_right=inset+g.content_right-8*scale
    if expanded then
        local queue_names={'MeterQueueHeaderTrack'}
        for row=1,5 do queue_names[#queue_names+1]='MeterQueueRow'..row end
        for _,name in ipairs(queue_names) do
            local meter=SKIN:GetMeter(name)
            inside(name,width,height)
            check(math.abs(meter:GetX(true)-(queue_x+22*scale))<=1,'Queue text column alignment wrong: '..name)
            check(math.abs(meter:GetX(true)+meter:GetW()-queue_right)<=1,'Queue width wrong: '..name)
            check(meter:GetY(true)>=art_y+art_size+4*scale-1 and meter:GetY(true)>=inset+g.body+4*scale-1,'Queue is not below the artwork and panel: '..name)
        end
        for row=1,5 do
            local number=SKIN:GetMeter('MeterQueueNumber'..row)
            check(number:GetOption('StringAlign')=='Right' and math.abs(number:GetX(true)-(queue_x+16*scale))<=1,'Queue position column alignment wrong: '..row)
        end
        check(math.abs(SKIN:GetMeter('MeterQueueHeaderTrack'):GetY(true)-(inset+g.queue_top))<=1,'Queue header is not at the drawer top')
    end
end
local function artwork_stage()
    local prefs=preferences()
    check(tonumber(prefs.Columns)==SELF:GetNumberOption('ExpectedColumns'),'Artwork changed saved width')
    local expanded=stage==2
    accordion(expanded,5,true)
    artwork_bounds(expanded)
    check(prefs.QueueExpanded==(expanded and '1' or '0'),'Artwork queue preference did not persist')
    if stage==1 then advance(2,'ToggleQueue')
    elseif stage==2 then
        typography()
        missing_time()
        if SELF:GetNumberOption('ExpectedWidth')>=220 then advance(3,'ToggleQueue') else return true end
    elseif stage==3 then return true
    else error('Unexpected artwork stage') end
    return false
end
local function header_stage()
    local prefs=preferences()
    check(prefs.QueueExpanded=='0','Header fixture preference changed')
    local original=read(SELF:GetOption('PreferencesPath'))
    local scale=SELF:GetNumberOption('ExpectedScale')
    local columns=SELF:GetNumberOption('ExpectedColumns')
    local rounded=function(value) return math.floor(value+0.5) end
    local inset=rounded(tonumber(SKIN:GetVariable('Gutter'))*scale/2)
    local queue=kind=='HeaderQueue'
    local offset=queue and 0 or rounded(12*(columns-1)*scale)
    local width,height
    if queue then
        width=columns*(rounded(SELF:GetNumberOption('ExpectedWidth')*scale)+2*inset)
        height=rounded(162*scale)+2*inset
        check(SKIN:GetW()==width and SKIN:GetH()==height,'Standalone queue header changed window dimensions')
    else width,height=dimensions(false,5) end
    local measure=assert(SKIN:GetMeasure('MeasureQueueStatus'))
    check(measure:GetOption('QueueCachePath')==SELF:GetOption('SyntheticCachePath'),'Header fixture cache is not synthetic')
    check(measure:GetStringValue()=='Next 5','Synthetic queue fixture unavailable')
    if kind=='HeaderPlayer' then
        check(SKIN:GetMeasure('MeasureMediaSource'):GetOption('Measure')=='String','Header fixture loaded a real source reader')
        check(SKIN:GetMeasure('MeasureSourceArtist'):GetOption('Measure')=='String','Header raw artist is not synthetic')
    end
    local gear=assert(SKIN:GetMeter('MeterMediaOptions'))
    check(gear:GetW()==0,'Header gear must begin hidden')
    local enter,leave=SELF:GetOption('HoverEnter'),SELF:GetOption('HoverLeave')
    check(enter=='[!ShowMeter MeterMediaOptions][!Redraw]','Unexpected hover entry command')
    check(leave=='[!HideMeter MeterMediaOptions][!Redraw]','Unexpected hover leave command')
    SKIN:Bang(enter)
    check(gear:GetW()==18*scale and gear:GetH()==18*scale,'Hover did not reveal the expected gear bounds')
    local expected_y=inset+offset+6*scale
    check(gear:GetY(true)==expected_y,string.format('Gear Y %g expected %g (%s)',gear:GetY(true),expected_y,kind))
    check(gear:GetX(true)==width-inset-rounded(tonumber(SKIN:GetVariable('PanelPadding'))*scale)-18*scale,'Gear right inset changed')
    inside('MeterMediaOptions',width,height)
    local heading=assert(SKIN:GetMeter('MeterHeading'))
    check(heading:GetX(true)+heading:GetW()<=gear:GetX(true),'Gear overlaps heading')
    check(gear:GetOption('LeftMouseUpAction')=='[!ActivateConfig "Parallax\\Media\\Settings" "Settings.ini"]','Gear settings target changed')
    SKIN:Bang(leave)
    check(gear:GetW()==0,'Mouse leave did not hide header gear')
    check(read(SELF:GetOption('PreferencesPath'))==original,'Header hover changed saved preferences')
    glyph_report=string.format('gearY=%g expected=%g headerOffset=%g',gear:GetY(true),expected_y,offset)
    return true
end
local identity_icons={'MeterMediaIcon','MeterPlayerIcon'}
local identity_literal='Literal #IdentitySentinel# [!SetVariable IdentitySentinel escaped] [&MeasurePlayer:Tripwire()] "player"'
local function identity_transport()
    local scale=SELF:GetNumberOption('ExpectedScale')
    local online=stage~=7
    local playing=online and stage~=3
    local center=SKIN:GetMeter('MeterPlayPause')
    -- Shape..Shape3 are the shadow and accent face; the art starts at Shape4.
    -- Enabled glyphs use BackgroundColor against the face, disabled MutedColor.
    local function mode(expected,enabled)
        local art=center:GetOption('Shape4')
        if expected=='pause' then
            check(art:match('^Rectangle ') and art:find('Extend LucideTransportStroke',1,true) and center:GetOption('Shape5'):match('^Rectangle '),'Paused state must show pause rectangles')
        elseif expected=='step' then
            check(art=='Path LucideTransportStepForwardPath | Extend LucideTransportStroke','Paused hover must show step-forward')
            check(center:GetOption('Shape5')=='Path LucideTransportStepForwardBarPath | Extend LucideTransportStroke','Step-forward bar missing')
        elseif expected=='hover' then
            check(art=='Path LucideTransportPlayOffUpperPath | Extend LucideTransportStroke','Supported hover must show play-off upper path')
            check(center:GetOption('Shape5')=='Path LucideTransportPlayOffLowerPath | Extend LucideTransportStroke','Play-off lower path missing')
            check(center:GetOption('Shape6')=='Path LucideTransportPlayOffSlashPath | Extend LucideTransportStroke','Play-off slash missing')
        else check(art=='Path LucideTransportPlayPath | Extend LucideTransportStroke','Play state or fallback must show play') end
        check(center:GetOption('LucideTransportStroke'):find('Stroke Color '..SKIN:GetVariable(enabled and 'BackgroundColor' or 'MutedColor'),1,true)~=nil,'Center transport stroke ignores capability')
        check(center:GetOption('MouseActionCursor')==(enabled and '1' or '0'),'Center transport cursor ignores capability')
    end
    local first=SKIN:GetMeter('MeterPrevious')
    for index,name in ipairs({'MeterPrevious','MeterPlayPause','MeterNext'}) do
        local meter=SKIN:GetMeter(name)
        check(meter:GetOption('Meter')=='Shape','Transport is not a vector Shape')
        check(math.abs(meter:GetW()-44*scale)<=1 and math.abs(meter:GetH()-44*scale)<=1,'Transport target dimensions changed')
        check(math.abs(meter:GetX(true)-first:GetX(true)-(index-1)*38*scale)<=1,'Transport spacing changed')
        check(meter:GetOption('LucideTransportStroke'):find('Stroke Color '..SKIN:GetVariable(online and 'BackgroundColor' or 'MutedColor'),1,true)~=nil,'Transport stroke ignores connection')
    end
    mode(online and not playing and 'pause' or 'play',online)
    local enter,leave=center:GetOption('MouseOverAction'),center:GetOption('MouseLeaveAction')
    check(enter=='[!CommandMeasure "MeasureMediaUI" "HoverPlayPause(true)"]','Unexpected play/pause hover command')
    check(leave=='[!CommandMeasure "MeasureMediaUI" "HoverPlayPause(false)"]','Unexpected play/pause leave command')
    local state=SKIN:GetMeasure('MeasureState'):GetValue()
    SKIN:Bang(enter)
    mode(playing and 'hover' or online and 'step' or 'play',online)
    if stage==1 or stage==3 then
        SKIN:Bang('!SetOption','MeasureCanPlayPause','Formula','0')
        SKIN:Bang('!UpdateMeasure','MeasureCanPlayPause')
        SKIN:Bang('!UpdateMeasure','MeasureMediaUI')
        mode(playing and 'play' or 'pause',false)
        SKIN:Bang('!SetOption','MeasureCanPlayPause','Formula','1')
        SKIN:Bang('!UpdateMeasure','MeasureCanPlayPause')
        SKIN:Bang('!UpdateMeasure','MeasureMediaUI')
    end
    SKIN:Bang(leave)
    mode(online and not playing and 'pause' or 'play',online)
    check(SKIN:GetMeasure('MeasureState'):GetValue()==state,'Hover fabricated playback state')
    check(SKIN:GetVariable('FixturePlaybackCommands')=='0','Hover dispatched a playback command')
end
queue_transport_checks=function()
    local report={}
    local cover=SKIN:GetMeasure('MeasureCover')
    local original_cover=cover:GetOption('String')
    check(cover:GetOption('Measure')=='String' and original_cover:match('synthetic%-cover%.png$'),'Missing-cover probe must remain synthetic')
    SKIN:Bang('!SetOption','MeasureCover','String','')
    SKIN:Bang('!UpdateMeasure','MeasureCover')
    SKIN:Bang('!UpdateMeasure','MeasureMediaUI')
    local caption,caption_probe=SKIN:GetMeter('MeterCoverLabel'),SKIN:GetMeter('ProbeMeterCoverLabel')
    check(caption:GetW()>0 and text('MeterCoverLabel')=='N/A','Missing cover caption is not visible')
    for option,default in pairs({FontFace='Arial',FontSize='10',FontWeight='400',StringStyle='Normal',StringCase='None',CharacterSpacing='0'}) do
        SKIN:Bang('!SetOption','ProbeMeterCoverLabel',option,caption:GetOption(option,default))
    end
    SKIN:Bang('!UpdateMeter','ProbeMeterCoverLabel')
    caption_probe:Show();local caption_w,caption_h=caption_probe:GetW(),caption_probe:GetH();caption_probe:Hide()
    check(caption_w>0 and caption_h>0 and caption_w<=caption:GetW() and caption_h<=caption:GetH(),'N/A glyphs do not fit the reduced cover')
    report[#report+1]=string.format('N/A=%dx%d/%dx%d',caption_w,caption_h,caption:GetW(),caption:GetH())
    SKIN:Bang('!SetOption','MeasureCover','String',original_cover)
    SKIN:Bang('!UpdateMeasure','MeasureCover')
    SKIN:Bang('!UpdateMeasure','MeasureMediaUI')
    check(caption:GetW()==0 and SKIN:GetMeter('MeterCover'):GetW()>0,'Synthetic cover did not restore')
    local duration=SKIN:GetMeasure('MeasureDuration')
    local original=duration:GetOption('Formula')
    local timing=SKIN:GetMeter('MeterTiming')
    local original_text=timing:GetOption('Text')
    local function update_availability(formula)
        SKIN:Bang('!SetOption','MeasureDuration','Formula',formula)
        SKIN:Bang('!UpdateMeasure','MeasureDuration')
        SKIN:Bang('!UpdateMeasure','MeasureMediaUI')
        SKIN:Bang('!UpdateMeterGroup','MediaTimeline')
        SKIN:Bang('!UpdateMeterGroup','MediaDynamic')
    end
    update_availability('0')
    check(timing:GetW()==0,'Unavailable time did not hide known time')
    local _,detail=transport_layout('MeterTimingUnavailable'); report[#report+1]=detail
    update_availability(original)
    local widths={}
    for _,sample in ipairs({'0 / 1','0:45 / 3:00',string.rep('9',48)..' / '..string.rep('9',48),'0 / 1'}) do
        SKIN:Bang('!SetOption','MeterTiming','Text',sample)
        SKIN:Bang('!UpdateMeter','MeterTiming')
        local width,description=transport_layout('MeterTiming')
        widths[#widths+1]=width;report[#report+1]=description
    end
    check(widths[3]>widths[1] and widths[4]==widths[1],'Timing width did not grow and shrink after text changed')
    SKIN:Bang('!SetOption','MeterTiming','Text',original_text)
    SKIN:Bang('!UpdateMeter','MeterTiming')
    transport_layout('MeterTiming')
    for _,command_name in ipairs({'Previous','Next'}) do
        local meter=SKIN:GetMeter('Meter'..command_name)
        local enter,leave=meter:GetOption('MouseOverAction'),meter:GetOption('MouseLeaveAction')
        check(enter=='[!CommandMeasure "MeasureMediaUI" "HoverTransport(\''..command_name..'\',true)"]','Unexpected transport hover action')
        check(leave=='[!CommandMeasure "MeasureMediaUI" "HoverTransport(\''..command_name..'\',false)"]','Unexpected transport leave action')
        check(meter:GetOption('LucideTransportStroke'):find('Fill Color 0,0,0,0',1,true)~=nil,'Normal skip control is filled')
        SKIN:Bang(enter)
        check(meter:GetOption('LucideTransportStroke'):find('Fill Color '..SKIN:GetVariable('BackgroundColor'),1,true)~=nil,'Supported skip hover is not filled')
        SKIN:Bang(leave)
        check(meter:GetOption('LucideTransportStroke'):find('Fill Color 0,0,0,0',1,true)~=nil,'Skip hover fill did not clear')
    end
    identity_transport()
    timing_report=table.concat(report,'; ')..'; hover playback dispatches='..SKIN:GetVariable('FixturePlaybackCommands')
end
local function identity_stage()
    local prefs=preferences()
    check(read(SELF:GetOption('PreferencesPath'))==identity_preferences,'Identity transition changed preferences')
    check(prefs.QueueExpanded=='0','Identity fixture expansion changed')
    local setup=kind=='IdentitySetup'
    -- Only a connected, Playing (state 1) sample with a nonblank title names
    -- the player. Stage 3 is paused (state 2); 7 is disconnected, 8 idle.
    local expected=setup and 'stopped' or ({'Spotify','YouTube','paused','Unknown','Quod Libet Player',identity_literal,'stopped','stopped','Spotify'})[stage]
    local measure=assert(SKIN:GetMeasure('MeasureMediaHeader'))
    check(measure:GetOption('Measure')=='Script' and measure:GetOption('ScriptFile'):match('MediaHeader%.lua$'),'Production header adapter missing')
    check(measure:GetStringValue()==title_label()..expected,'Identity data mismatch at stage '..stage..': '..measure:GetStringValue())
    if not setup then
        check(SKIN:GetMeasure('MeasurePlayer'):GetOption('Measure')=='Script','Raw player fixture must preserve literal data')
        check(SKIN:GetMeasure('MeasureMediaSource'):GetOption('Measure')=='String','Real source reader in identity fixture')
        check(SKIN:GetMeasure('MeasureSourceArtist'):GetOption('Measure')=='String','Raw artist fixture not synthetic')
        if stage==3 then check(SKIN:GetMeasure('MeasureMediaUI'):GetStringValue()=='Paused','Pause transition not applied') end
        if stage==6 then check(SKIN:GetMeasure('MeasurePlayer'):GetStringValue()==identity_literal,'Literal fixture was expanded before header binding') end
        identity_transport()
    else check(SKIN:GetMeasure('MeasureConnection')==nil,'Setup loaded player data') end
    -- Also asserts exactly one title icon, matching the text's playing test.
    header_row(expected)
    check(SKIN:GetVariable('IdentitySentinel')=='unchanged','Literal player data executed or expanded a fixture command')
    local width,height=dimensions(false,5)
    if not setup then
        local sizes={}
        for _,name in ipairs({'MeterSongIcon','MeterArtistIcon','MeterAlbumIcon','MeterCoverFrame','MeterTrackTitle'}) do
            local icon=assert(SKIN:GetMeter(name))
            check((icon:GetW()>0)==(stage~=7 and stage~=8),'Track meter visibility did not follow connection/title: '..name)
            sizes[#sizes+1]=name..'='..icon:GetW()..'x'..icon:GetH()
        end
        identity_metadata[#identity_metadata+1]='stage'..stage..':'..table.concat(sizes,',')
    end
    for _,name in ipairs(identity_icons) do inside(name,width,height) end
    inside('MeterHeading',width,height)
    if setup or stage==9 then
        artwork_bounds(false)
        local target,probe=SKIN:GetMeter('MeterHeading'),SKIN:GetMeter('ProbeMeterHeading')
        probe:Show();local w,h=probe:GetW(),probe:GetH();probe:Hide()
        glyph_report=glyph_fit('MeterHeading',target,w,h)..'; long literal names clip with ClipString=1 and no tooltip'
        if #identity_metadata>0 then glyph_report=glyph_report..'\nmetadata='..table.concat(identity_metadata,'; ') end
        return true
    end
    stage=stage+1; tick=0; done=false
    -- MeasureMediaHeader samples every #MediaLegacyDivider# ticks; wait out a
    -- full cycle so the title is observed at its production cadence.
    settle_ticks=formula('#MediaLegacyDivider#')+3
    -- Only fixed test-owned commands change synthetic measures. The observed
    -- metadata never enters an option or a bang, including the adversarial case.
    SKIN:Bang('!CommandMeasure','MeasurePlayer','Select('..stage..')')
    SKIN:Bang('!UpdateMeasure','MeasurePlayer')
    SKIN:Bang('!SetOption','MeasureState','Formula',stage==3 and '2' or '1')
    SKIN:Bang('!UpdateMeasure','MeasureState')
    SKIN:Bang('!SetOption','MeasureConnection','Formula',stage==7 and '0' or '1')
    SKIN:Bang('!UpdateMeasure','MeasureConnection')
    SKIN:Bang('!SetOption','MeasureMediaSource','String',stage==4 and 'Windows Media Session' or 'Spotify')
    SKIN:Bang('!UpdateMeasure','MeasureMediaSource')
    SKIN:Bang('!SetVariable','FixtureIdle',stage==8 and '1' or '0')
    SKIN:Bang('!UpdateMeasure','MeasureTitle')
    return false
end
local function title_row_stage()
    local original=read(SELF:GetOption('PreferencesPath'))
    preferences()
    local scale=SELF:GetNumberOption('ExpectedScale')
    local columns=SELF:GetNumberOption('ExpectedColumns')
    local rounded=function(n) return math.floor(n+0.5) end
    local inset=rounded(tonumber(SKIN:GetVariable('Gutter'))*scale/2)
    local queue=kind:match('Queue$')~=nil
    local settings=is_settings()
    local center=inset+15*scale+((queue or settings) and 0 or rounded(12*(columns-1)*scale))
    local width,height
    if queue then
        width=columns*(rounded(SELF:GetNumberOption('ExpectedWidth')*scale)+2*inset)
        height=rounded(162*scale)+2*inset
        check(SKIN:GetW()==width and SKIN:GetH()==height,'Standalone Queue bounds changed')
    else width,height=dimensions(false,5) end
    local title=SKIN:GetMeter(settings and 'MeterTitle' or 'MeterHeading')
    check(title:GetOption('StringAlign')==(settings and 'CenterCenter' or 'LeftCenter'),'Title is not vertically centered')
    check(math.abs(title:GetY(true)-center)<=1,'Title anchor is not the shared row center')
    check(math.abs(title:GetH()-22*scale)<=1,'Title row height changed')
    inside(settings and 'MeterTitle' or 'MeterHeading',width,height)
    local info={}
    for _,name in ipairs(probe_names()) do
        local target,probe=SKIN:GetMeter(name),SKIN:GetMeter('Probe'..name)
        probe:Show();local w,h=probe:GetW(),probe:GetH();probe:Hide()
        info[#info+1]=glyph_fit(name,target,w,h)..string.format(' centerY=%g',target:GetY(true))
    end
    if settings then
        local close=SKIN:GetMeter('MeterClose')
        check(close:GetOption('StringAlign')=='CenterCenter' and math.abs(close:GetY(true)-center)<=1,'Settings close is not on the title center')
        settings_bounds()
    else
        local gear=SKIN:GetMeter('MeterMediaOptions')
        check(gear:GetW()==0,'Gear must start hidden')
        SKIN:Bang(SELF:GetOption('HoverEnter'))
        check(math.abs(gear:GetY(true)+gear:GetH()/2-center)<=1,'Gear center differs from title center')
        check(title:GetX(true)+title:GetW()<=gear:GetX(true)+1,'Title overlaps gear')
        inside('MeterMediaOptions',width,height)
        SKIN:Bang(SELF:GetOption('HoverLeave'))
        check(gear:GetW()==0,'Gear must hide after hover')
        if queue then
            check(SKIN:GetMeter('MeterMediaIcon')==nil,'Standalone Queue unexpectedly gained an identity icon')
            check(math.abs(SKIN:GetMeter('MeterQueueStatus'):GetY(true)-(inset+26*scale))<=1,'Standalone status row moved')
        else
            -- Sizes and centers whichever single title icon is showing.
            header_row()
            inside('MeterMediaIcon',width,height)
            inside('MeterPlayerIcon',width,height)
            if kind:match('Player$') then
                check(SKIN:GetMeasure('MeasureMediaSource'):GetOption('Measure')=='String','Real source reader in title fixture')
                check(SKIN:GetMeasure('MeasureSourceArtist'):GetOption('Measure')=='String','Real raw artist in title fixture')
            else check(SKIN:GetMeasure('MeasureConnection')==nil,'Setup loaded player data') end
        end
    end
    check(read(SELF:GetOption('PreferencesPath'))==original,'Title check changed preferences')
    glyph_report=table.concat(info,'; ')
    return true
end
local function write_status(state)
    local lines={'PARALLAX_QUEUE_V2','state='..state,'observed=0','valid_until=0','retry_not_before=0','count=0'}
    for index=1,5 do lines[#lines+1]='title'..index..'='; lines[#lines+1]='detail'..index..'=' end
    write(SELF:GetOption('SyntheticCachePath'),table.concat(lines,'\n')..'\n')
end
local function empty_queue_stage()
    local prefs=preferences()
    local trace_path=SKIN:GetVariable('@')..'User\\EmptyActions.trace'
    local function trace() return read(trace_path) end
    if stage==1 then
        accordion(false,5,true)
        check(trace()=='','Queue wrote on load')
        advance(2,'ToggleQueue')
    elseif stage==2 then
        accordion(true,5,true)
        check(trace()=='!WriteKeyValue\n!Refresh\n!Refresh\n','Explicit expand action count wrong')
        write_status('error');SKIN:Bang('!UpdateMeasure','MeasureQueueStatus');settle(3)
    elseif stage==3 then
        dimensions(true,5)
        check(prefs.QueueExpanded=='1','Error snapshot collapsed queue')
        check(SKIN:GetMeasure('MeasureQueueStatus'):GetStringValue()=='Queue error','Error snapshot not shown')
        check(trace()=='!WriteKeyValue\n!Refresh\n!Refresh\n','Error snapshot wrote/refreshed')
        local lines={'PARALLAX_QUEUE_V2','state=ready','observed='..os.time(),'valid_until='..(os.time()+240),'retry_not_before=0','count=0'}
        for i=1,5 do lines[#lines+1]='title'..i..'=';lines[#lines+1]='detail'..i..'=' end
        write(SELF:GetOption('SyntheticCachePath'),table.concat(lines,'\n')..'\n')
        write(SELF:GetOption('StageFile'),'4|'..tostring(previous_checks+checks))
        SKIN:Bang('!UpdateMeasure','MeasureQueueStatus')
    elseif stage==4 then
        dimensions(false,5)
        check(prefs.QueueExpanded=='0','Fresh empty snapshot did not save collapsed preference')
        check(SKIN:GetMeasure('MeasureQueueStatus'):GetStringValue()=='Queue empty','Empty status not retained')
        for i=1,5 do check(SKIN:GetMeter('MeterQueueRow'..i):GetW()==0,'Empty collapsed row remains visible') end
        check(SKIN:GetMeter('MeterQueueToggle'):GetOption('Shape6'):find('(1-0)',1,true)~=nil,'Empty queue did not restore plus icon')
        local before=trace()
        check(before==string.rep('!WriteKeyValue\n!Refresh\n!Refresh\n',2),'Empty transition did not save/refresh exactly once')
        for i=1,4 do SKIN:Bang('!UpdateMeasure','MeasureQueueStatus') end
        command('MeasureMediaOptions','CollapseEmptyQueue')
        check(trace()==before,'Duplicate empty state wrote or refreshed')
        local lines={'PARALLAX_QUEUE_V2','state=ready','observed='..os.time(),'valid_until='..(os.time()+240),'retry_not_before=0','count=5'}
        local function hex(value) return (value:gsub('.',function(c) return string.format('%02X',c:byte()) end)) end
        for i=1,5 do lines[#lines+1]='title'..i..'='..hex('Synthetic item '..i);lines[#lines+1]='detail'..i..'='..hex('Test artist '..i) end
        write(SELF:GetOption('SyntheticCachePath'),table.concat(lines,'\n')..'\n')
        SKIN:Bang('!UpdateMeasure','MeasureQueueStatus');settle(5)
    elseif stage==5 then
        accordion(false,5,true)
        check(prefs.QueueExpanded=='0','New nonempty snapshot reopened queue')
        check(trace()==string.rep('!WriteKeyValue\n!Refresh\n!Refresh\n',2),'Nonempty snapshot wrote or refreshed')
        return true
    else error('Unexpected empty queue stage') end
    return false
end
local function compact_status_stage()
    local expected=({[2]='Queue error',[3]='Quota reached',[4]='Stopped'})[stage]
    check(SKIN:GetMeasure('MeasureQueueStatus'):GetStringValue()==expected,'Compact footer substitution failed: '..tostring(expected))
    if stage==4 then return true end
    write_status(stage==2 and 'quota_exceeded' or 'stopped')
    advance(stage+1)
    return false
end
function Initialize()
    kind=SELF:GetOption('Kind')
    if kind:match('^Identity') then
        identity_preferences=read(SELF:GetOption('PreferencesPath'))
        SKIN:Bang('!SetVariable','IdentitySentinel','unchanged')
    end
    local saved_stage,saved_checks=read(SELF:GetOption('StageFile')):match('^(%d+)|(%d+)')
    stage=tonumber(saved_stage) or 1; previous_checks=tonumber(saved_checks) or 0
end
function Update()
    if kind=='SyncSettings' then
        local before=checks
        local ok,result=pcall(function()
            local prefs=preferences()
            settings_bounds(prefs.QueueExpanded=='1')
            check(prefs.QueueRowLimit=='5' and prefs.QueueShowDetails=='1','Footer toggle changed saved display choices')
            return text('MeterQueueExpandedValue')
        end)
        write(SELF:GetOption('SyncLabelFile'),ok and (result..'|'..tostring(checks-before)) or ('FAIL '..tostring(result)))
        checks=before
        return 0
    end
    tick=tick+1
    if tick==1 and kind~='SyncMain' and not kind:match('^Header') then prepare_probes() end
    if done or tick<settle_ticks then return 0 end
    done=true
    local status_only=SELF:GetOption('StatusProbeOnly','0')=='1'
    local scenario=SELF:GetOption('EmptyQueueTransition','0')=='1' and empty_queue_stage or kind:match('^TitleRow') and title_row_stage or kind:match('^Identity') and identity_stage or kind:match('^Header') and header_stage or status_only and stage>1 and compact_status_stage or kind:match('^Artwork') and artwork_stage or kind:match('^Typography') and typography_stage or (kind=='Accordion' or kind:match('^QueueToggle')) and accordion_stage or kind=='SyncMain' and sync_stage or settings_stage
    local ok,finished=pcall(scenario)
    if ok and finished and kind~='SyncMain' and not kind:match('^Artwork') and not kind:match('^Header') and not kind:match('^Identity') and not kind:match('^TitleRow') and not (status_only and stage>1) then ok,finished=pcall(function() typography(); return true end) end
    if ok and finished and status_only and stage==1 then
        write_status('error'); advance(2); finished=false
    end
    if not ok or finished then
        local report=string.format('%s kind=%s width=%d scale=%g columns=%d stage=%d checks=%d',
            ok and 'PASS' or 'FAIL',kind,SELF:GetNumberOption('ExpectedWidth'),SELF:GetNumberOption('ExpectedScale'),
            SELF:GetNumberOption('ExpectedColumns'),stage,previous_checks+checks)
        if not ok then report=report..'\n'..tostring(finished) end
        if glyph_report~='' then report=report..'\nglyphs='..glyph_report end
        if #fit_report>0 then report=report..'\nfit='..table.concat(fit_report,'; ') end
        if timing_report~='' then report=report..'\ntiming='..timing_report end
        -- Rendered bounds for the runner's pixel checks, so it samples where
        -- the skin actually drew rather than re-deriving the layout.
        local bounds={}
        for _,name in ipairs({'MeterCoverMask','MeterArtworkPlaceholder','MeterMediaIcon','MeterPlayerIcon','MeterSongIcon','MeterArtistIcon','MeterAlbumIcon',
            'MeterProgress','MeterPrevious','MeterPlayPause','MeterNext','MeterQueueToggle'}) do
            local meter=not is_settings() and SKIN:GetMeter(name)
            if meter then bounds[#bounds+1]=string.format('%s:%g,%g,%g,%g',name,meter:GetX(true),meter:GetY(true),meter:GetW(),meter:GetH()) end
        end
        if #bounds>0 then report=report..'\nbounds='..table.concat(bounds,';') end
        write(SELF:GetOption('ResultFile'),report..'\n')
    end
    return 0
end
