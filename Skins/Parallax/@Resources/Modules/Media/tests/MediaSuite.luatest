-- Developer-only synthetic behavior tests (.luatest excludes packaging).
-- No provider/plugin or real SKIN calls.
-- Production Media.lua runs unchanged under a mock SKIN in Rainmeter's Lua 5.1.
local suite = {}

function suite.run(sourcePath, optionsPath)
    local passed, cases = 0, {}
    local function check(condition, message)
        assert(condition, message)
        passed = passed + 1
    end
    local function scenario(name, test)
        local before = passed
        test()
        cases[#cases + 1] = name .. ': ' .. (passed - before) .. ' assertions'
    end
    local function fixture()
        local calls = {}
        local values = {
            MeasureConnection = { value = 1 },
            MeasureTitle = { text = 'Synthetic title for tests only' },
            MeasureCover = { text = 'synthetic-cover-no-file.png' },
            MeasureState = { value = 1 },
            MeasurePosition = { value = 30 },
            MeasureDuration = { value = 180 },
            MeasureCanPrevious = { value = 1 },
            MeasureCanPlayPause = { value = 1 },
            MeasureCanNext = { value = 1 }
        }
        local variables = {
            MediaColor = '71,120,160',
            MutedColor = '111,112,113',
            AccentColor = '137,190,250',
            BackgroundColor = '24,25,26',
            Columns = '2',
            Scale = '1'
        }
        local geometry = { left = 200, right = 448 }
        local timing = { MeterTiming = { x = 365, w = 83 }, MeterTimingUnavailable = { x = 390, w = 58 } }
        local mock = {}
        function mock:GetMeasure(name)
            local value = values[name]
            if value == false then return nil end
            assert(value, 'Unexpected measure lookup: ' .. tostring(name))
            return {
                GetValue = function() return value.value end,
                GetStringValue = function() return value.text end
            }
        end
        function mock:GetVariable(name)
            assert(variables[name], 'Unexpected variable lookup: ' .. tostring(name))
            return variables[name]
        end
        function mock:GetMeter(name)
            local meter = timing[name]
            if meter == false then return nil end
            assert(meter, 'Unexpected layout meter lookup')
            return { GetX = function(_, anchor) return anchor and meter.x + meter.w or meter.x end,
                GetW = function() return meter.w end }
        end
        function mock:ReplaceVariables(formula)
            if formula == '(#MediaTransportLeft#)' then return 'LEFT' end
            if formula == '(#ContentX#+#ContentWidth#)' then return 'RIGHT' end
            error('Layout formula must contain only fixed geometry variables')
        end
        function mock:ParseFormula(formula)
            if formula == 'LEFT' then return geometry.left end
            if formula == 'RIGHT' then return geometry.right end
            error('Unexpected geometry formula')
        end
        function mock:Bang(...)
            calls[#calls + 1] = { ... }
        end
        local env = setmetatable({ SKIN = mock }, { __index = _G })
        local chunk = assert(loadfile(sourcePath))
        setfenv(chunk, env)
        chunk()
        env.Initialize()
        check(#calls == 0, 'Initialize must not issue commands')
        local instance = { env = env, values = values, variables = variables, geometry = geometry, timing = timing }
        function instance.reset() calls = {} end
        function instance.calls() return calls end
        function instance.count(bang, target)
            local count = 0
            for _, call in ipairs(calls) do
                if call[1] == bang and (target == nil or call[2] == target) then count = count + 1 end
            end
            return count
        end
        function instance.option(target, key)
            local found = nil
            for _, call in ipairs(calls) do
                if call[1] == '!SetOption' and call[2] == target and call[3] == key then found = call[4] end
            end
            return found
        end
        function instance.strokeColor(target)
            local stroke = instance.option(target, 'LucideTransportStroke')
            return stroke and stroke:match('Stroke Color ([^|]-) |')
        end
        function instance.symbol()
            local shape = instance.option('MeterPlayPause', 'Shape4')
            if shape == 'Path LucideTransportPlayPath | Extend LucideTransportStroke' then return 'play' end
            if shape == 'Path LucideTransportPlayOffUpperPath | Extend LucideTransportStroke' then return 'playOff' end
            if shape == 'Path LucideTransportStepForwardPath | Extend LucideTransportStroke' then return 'stepForward' end
            if shape == 'Rectangle (14*#Scale#),(3*#Scale#),(5*#Scale#),(18*#Scale#),#Scale# | Extend LucideTransportStroke' then return 'pause' end
            return nil
        end
        function instance.visible(target, isGroup)
            local show = isGroup and '!ShowMeterGroup' or '!ShowMeter'
            local hide = isGroup and '!HideMeterGroup' or '!HideMeter'
            local found = nil
            for _, call in ipairs(calls) do
                if call[2] == target then
                    if call[1] == show then found = true end
                    if call[1] == hide then found = false end
                end
            end
            return found
        end
        -- The transport meters use UpdateDivider=-1, and Rainmeter 4.5 applies a
        -- !SetOption to such a meter only when it is forced to update. So every
        -- meter whose options changed is forced exactly once, after its last
        -- option, and no other meter or group is: periodic samples included,
        -- or a play/pause from another app keeps the old art until hover.
        function instance.assertRefresh(immediate)
            local lastSet, forced, lastForce = {}, {}, 0
            for index, call in ipairs(calls) do
                if call[1] == '!SetOption' then lastSet[call[2]] = index end
            end
            for index, call in ipairs(calls) do
                if call[1] == '!UpdateMeter' then
                    forced[call[2]] = (forced[call[2]] or 0) + 1
                    check(lastSet[call[2]] ~= nil, 'An unchanged meter was forced: ' .. tostring(call[2]))
                    check(index > (lastSet[call[2]] or math.huge), 'A meter must be forced after its options are set')
                    lastForce = index
                end
            end
            for meter in pairs(lastSet) do
                check(forced[meter] == 1, 'A changed UpdateDivider=-1 meter must be forced exactly once: ' .. meter)
            end
            check(instance.count('!UpdateMeterGroup', 'MediaDynamic') == 0,
                'A MediaDynamic group update would also force unchanged meters')
            check(instance.count('!Redraw') == (immediate and 1 or 0),
                immediate and 'Interactive UI change must redraw exactly once'
                    or 'Periodic UI change must leave the repaint to the provider tick\'s own skin cycle')
            if immediate then
                for index, call in ipairs(calls) do
                    if call[1] == '!Redraw' then check(index > lastForce, 'Interactive redraw must follow the forced updates') end
                end
            end
            check(instance.count('!CommandMeasure') == 0, 'Update must not send playback commands')
        end
        return instance
    end

    scenario('connected playing baseline', function()
        local f = fixture()
        check(f.env.Update() == 'Playing', 'Playing status was lost')
        check(f.visible('MediaTrack', true) == true, 'Connected title must show track')
        check(f.visible('MeterNoMedia') == false, 'Track must hide no-media fallback')
        check(f.visible('MediaTimeline', true) == true, 'Valid timing must show timeline')
        check(f.visible('MeterTimingUnavailable') == false, 'Valid timing must hide unavailable marker')
        check(f.visible('MeterCover') == true, 'Nonempty cover must show')
        check(f.visible('MeterCoverLabel') == false, 'No art label must not show through transparent artwork')
        check(f.visible('MeterArtworkLabel') == false, 'Idle label must not show behind a track')
        check(f.visible('MeterArtworkPlaceholder') == false, 'Idle border must not double-paint behind a track')
        check(f.symbol() == 'play', 'Playing must display the current-state Lucide Play path')
        for _, meter in ipairs({ 'MeterPrevious', 'MeterPlayPause', 'MeterNext' }) do
            check(f.strokeColor(meter) == '24,25,26', 'Enabled glyph must use BackgroundColor against its AccentColor face')
            check(f.option(meter, 'MouseActionCursor') == '1', 'Supported control must have active cursor')
            check(f.option(meter, 'ToolTipText') == nil, 'Transport controls must not set a tooltip')
        end
        f.assertRefresh()
    end)

    scenario('repeated and metadata-only samples avoid redundant bangs', function()
        local f = fixture()
        f.env.Update()
        f.reset()
        check(f.env.Update() == 'Playing' and #f.calls() == 0, 'Identical sample caused redundant display work')
        f.values.MeasurePosition.value = 31
        f.values.MeasureTitle.text = 'Another synthetic title'
        f.values.MeasureCover.text = 'another-synthetic-cover-no-file.png'
        check(f.env.Update() == 'Playing' and #f.calls() == 0, 'Bound measure metadata caused unnecessary bangs')
        f.values.MeasureState.value = 2
        check(f.env.Update() == 'Paused', 'Paused status incorrect')
        check(f.symbol() == 'pause', 'Paused must display the current-state Lucide Pause shapes')
        check(f.count('!SetOption') == 2, 'Play-to-pause transition should change only the two affected art shapes')
        f.assertRefresh()
        f.reset()
        check(f.env.Update() == 'Paused' and #f.calls() == 0, 'Paused repeat caused redundant bangs')
    end)

    scenario('external play/pause and capability changes force only the changed transport meters', function()
        -- Another app or a media key pauses playback: only the provider sample
        -- changes, at the provider cadence, with no hover and no click here.
        local f = fixture()
        f.env.Update()
        f.reset()
        f.values.MeasureState.value = 2
        check(f.env.Update() == 'Paused' and f.symbol() == 'pause', 'External pause must select the Pause art')
        check(f.count('!UpdateMeter', 'MeterPlayPause') == 1,
            'External pause must force the UpdateDivider=-1 play/pause meter, or its art stays stale until hover')
        check(f.count('!UpdateMeter') == 1, 'External pause must force only the play/pause meter')
        check(f.count('!UpdateMeterGroup') == 0, 'External pause must not force a meter group')
        f.assertRefresh()
        f.reset()
        check(f.env.Update() == 'Paused' and #f.calls() == 0, 'A repeated paused sample must issue no bang')
        f.values.MeasureState.value = 1
        check(f.env.Update() == 'Playing' and f.symbol() == 'play', 'External resume must restore the Play art')
        check(f.count('!UpdateMeter', 'MeterPlayPause') == 1 and f.count('!UpdateMeter') == 1,
            'External resume must force only the play/pause meter')
        f.assertRefresh()
        -- The player drops Next support: only Next's stroke and cursor change.
        f.reset()
        f.values.MeasureCanNext.value = 0
        check(f.env.Update() == 'Playing', 'A capability change must not change playback state')
        check(f.strokeColor('MeterNext') == '111,112,113' and f.option('MeterNext', 'MouseActionCursor') == '0',
            'Unsupported Next must turn muted and inactive')
        check(f.count('!UpdateMeter', 'MeterNext') == 1 and f.count('!UpdateMeter') == 1,
            'A capability change must force only the meter it changes')
        f.assertRefresh()
        -- The provider disconnects: Previous and Play/Pause turn muted; Next
        -- already is, so it is not forced again.
        f.reset()
        f.values.MeasureConnection.value = 0
        check(f.env.Update() == 'WNP disconnected', 'Disconnect status incorrect')
        check(f.count('!UpdateMeter', 'MeterPrevious') == 1 and f.count('!UpdateMeter', 'MeterPlayPause') == 1
            and f.count('!UpdateMeter', 'MeterNext') == 0, 'Disconnect must force exactly the two meters it changes')
        f.assertRefresh()
        -- Reconnect while paused: every control and the art follow the sample.
        f.reset()
        f.values.MeasureConnection.value, f.values.MeasureCanNext.value, f.values.MeasureState.value = 1, 1, 2
        check(f.env.Update() == 'Paused' and f.symbol() == 'pause', 'Reconnect while paused must show Pause')
        check(f.count('!UpdateMeter') == 3, 'Reconnect must force each transport meter once')
        f.assertRefresh()
    end)

    scenario('disconnected hides stale content and gates controls', function()
        local f = fixture()
        f.values.MeasureConnection.value = 0
        check(f.env.Update() == 'WNP disconnected', 'Disconnected status incorrect')
        check(f.visible('MediaTrack', true) == false and f.visible('MeterNoMedia') == true, 'Disconnected track visibility incorrect')
        check(f.visible('MediaTimeline', true) == false and f.visible('MeterTimingUnavailable') == true, 'Disconnected timing visibility incorrect')
        check(f.visible('MeterCover') == false, 'Disconnected stale cover shown')
        check(f.symbol() == 'play', 'Disconnected icon must retain the fixed Play fallback')
        for _, meter in ipairs({ 'MeterPrevious', 'MeterPlayPause', 'MeterNext' }) do
            check(f.strokeColor(meter) == '111,112,113', 'Disconnected control must use MutedColor')
            check(f.option(meter, 'MouseActionCursor') == '0', 'Disconnected cursor must be inactive')
        end
        f.assertRefresh()
        f.reset()
        for _, command in ipairs({ 'Previous', 'PlayPause', 'Next' }) do check(f.env.Control(command) == false, 'Disconnected playback command accepted') end
        check(#f.calls() == 0, 'Disconnected control invoked bang')
    end)

    scenario('blank title is idle without fabricated track or timing', function()
        for _, title in ipairs({ '', ' ', '\r\n\t' }) do
            local f = fixture()
            f.values.MeasureTitle.text = title
            check(f.env.Update() == 'WNP idle', 'Blank title must report idle')
            check(f.visible('MediaTrack', true) == false and f.visible('MeterNoMedia') == true, 'Idle fallback incorrect')
            check(f.visible('MediaTimeline', true) == false and f.visible('MeterCover') == false, 'Idle state leaked timing or cover')
            check(f.strokeColor('MeterPlayPause') == '24,25,26', 'Independent capability should remain usable while idle')
        end
    end)

    scenario('known unknown and nonfinite playback states', function()
        local samples = {
            { value = 0, status = 'Stopped', symbol = 'play' },
            { value = 1, status = 'Playing', symbol = 'play' },
            { value = 2, status = 'Paused', symbol = 'pause' },
            { value = '1', status = 'Playing', symbol = 'play' },
            { value = 3, status = 'State unknown', symbol = 'play' },
            { value = -1, status = 'State unknown', symbol = 'play' },
            { value = 'bogus', status = 'State unknown', symbol = 'play' },
            { value = 0 / 0, status = 'State unknown', symbol = 'play' },
            { value = math.huge, status = 'State unknown', symbol = 'play' },
            { value = -math.huge, status = 'State unknown', symbol = 'play' },
            { status = 'State unknown', symbol = 'play' }
        }
        for _, sample in ipairs(samples) do
            local f = fixture()
            f.values.MeasureState.value = sample.value
            check(f.env.Update() == sample.status, 'Incorrect playback-state classification')
            check(f.symbol() == sample.symbol, 'Incorrect playback-state vector selection')
            if sample.value == 0 or sample.value == 3 then
                f.reset()
                check(f.env.HoverPlayPause(true) == true and f.symbol() == 'playOff', 'Supported stopped/unknown fallback must retain Play Off hover')
                f.assertRefresh(true)
                f.reset()
                check(f.env.HoverPlayPause(false) == true and f.symbol() == 'play', 'Leaving stopped/unknown hover must restore plain Play')
                f.assertRefresh(true)
            end
        end
    end)

    scenario('invalid connection cannot enable UI or playback', function()
        for _, value in ipairs({ -1, 2, 'bogus', 0 / 0, math.huge, -math.huge }) do
            local f = fixture()
            f.values.MeasureConnection.value = value
            check(f.env.Update() == 'WNP disconnected', 'Only connection==1 may be connected')
            f.reset()
            check(f.env.Control('PlayPause') == false and #f.calls() == 0, 'Invalid connection allowed playback')
        end
    end)

    scenario('transport support is independent and rechecked on click', function()
        local commandMap = {
            { 'Previous', 'MeasureCanPrevious', 'MeterPrevious' },
            { 'PlayPause', 'MeasureCanPlayPause', 'MeterPlayPause' },
            { 'Next', 'MeasureCanNext', 'MeterNext' }
        }
        for _, spec in ipairs(commandMap) do
            local f = fixture()
            f.env.Update()
            for _, invalid in ipairs({ 0, 2, -1, 0.5, 'invalid', 0 / 0, math.huge }) do
                f.values[spec[2]].value = invalid
                f.reset()
                check(f.env.Control(spec[1]) == false and #f.calls() == 0, 'Stale enabled UI bypassed latest capability')
            end
            f.env.Update()
            check(f.strokeColor(spec[3]) == '111,112,113', 'Unsupported control must use MutedColor')
            check(f.option(spec[3], 'MouseActionCursor') == '0', 'Unsupported control cursor must be inactive')
            f.values[spec[2]].value = '1'
            f.reset()
            check(f.env.Control(spec[1]) == true, 'Supported string numeric capability rejected')
            local calls = f.calls()
            check(#calls == 1 and calls[1][1] == '!CommandMeasure' and calls[1][2] == 'MeasureConnection' and calls[1][3] == spec[1], 'Playback escaped expected command target')
            f.values.MeasureConnection.value = 0
            f.reset()
            check(f.env.Control(spec[1]) == false and #f.calls() == 0, 'Click-time disconnection was ignored')
        end
        local f = fixture()
        f.reset()
        for _, invalid in ipairs({ '', 'playpause', 'PlayPause][!Quit]', '!Quit', 'Seek' }) do check(f.env.Control(invalid) == false, 'Unrecognized playback command accepted') end
        check(f.env.Control(nil) == false and #f.calls() == 0, 'Nil command or injection invoked bang')
    end)

    scenario('missing measures stay unavailable', function()
        local f = fixture()
        for name in pairs(f.values) do f.values[name] = false end
        f.env.Initialize()
        check(f.env.Update() == 'WNP disconnected', 'Missing measures must be disconnected')
        check(f.visible('MediaTrack', true) == false and f.visible('MediaTimeline', true) == false, 'Missing measures exposed data')
        f.reset()
        check(f.env.Control('PlayPause') == false and #f.calls() == 0, 'Missing measure allowed control')
    end)

    scenario('invalid timing is unavailable while valid position zero is shown', function()
        local samples = {
            { duration = 0, position = 0 }, { duration = -1, position = 0 },
            { duration = math.huge, position = 0 }, { duration = 180, position = -1 },
            { duration = 180, position = math.huge }, { duration = 180, position = 0 / 0 },
            { position = 0 }, { duration = 180 }, { duration = 'invalid', position = 0 }
        }
        for _, sample in ipairs(samples) do
            local f = fixture()
            f.values.MeasureDuration.value, f.values.MeasurePosition.value = sample.duration, sample.position
            check(f.env.Update() == 'Playing', 'Missing timing must not fabricate playback state')
            check(f.visible('MediaTimeline', true) == false and f.visible('MeterTimingUnavailable') == true, 'Invalid timing shown as measured data')
        end
        local f = fixture()
        f.values.MeasurePosition.value = 0
        f.env.Update()
        check(f.visible('MediaTimeline', true) == true and f.visible('MeterTimingUnavailable') == false, 'Measured position zero must be valid')
    end)

    scenario('cover group transitions reapply explicit cover visibility', function()
        local f = fixture()
        f.values.MeasureCover.text = ''
        f.env.Update()
        check(f.visible('MeterCover') == false, 'Empty cover should hide')
        f.values.MeasureConnection.value = 0
        f.env.Update()
        f.reset()
        f.values.MeasureConnection.value = 1
        f.env.Update()
        check(f.visible('MediaTrack', true) == true, 'Reconnect must restore track group')
        check(f.count('!HideMeter', 'MeterCover') == 1, 'Reconnect group show must re-hide empty cover')
        check(f.count('!ShowMeter', 'MeterCoverLabel') == 1, 'Reconnect group must restore the missing-art label')
        f.reset()
        f.values.MeasureCover.text = 'synthetic-cover-no-file.png'
        f.env.Update()
        check(f.visible('MeterCover') == true, 'New nonblank cover should show')
        check(f.visible('MeterCoverLabel') == false, 'New artwork must hide its missing-art label')
        f.assertRefresh()
        f.reset()
        f.values.MeasureCover.text = ' \t\n'
        f.env.Update()
        check(f.visible('MeterCover') == false, 'Whitespace cover should hide')
        check(f.visible('MeterCoverLabel') == true, 'Missing artwork must restore its label')
        f.assertRefresh()
    end)

    scenario('idle placeholder follows width and survives track transitions', function()
        for _,columns in ipairs({'1','2'}) do
            local f=fixture()
            f.variables.Columns=columns
            f.values.MeasureConnection.value=0
            f.env.Update()
            check(f.visible('MeterArtworkLabel') == (columns=='2'), 'Idle tile label must follow width')
            check(f.visible('MeterArtworkPlaceholder') == (columns=='2'), 'Idle bordered tile must follow width')
            check(f.visible('MeterCoverLabel') == false, 'Disconnected track label must hide')
            f.reset()
            f.values.MeasureConnection.value=1
            f.env.Update()
            check(f.count('!HideMeter','MeterCoverLabel')==1, 'Group show must re-hide label beneath valid cover')
            if columns=='2' then
                check(f.visible('MeterArtworkPlaceholder') == false, 'Track must suppress the idle bordered tile')
            else
                check(f.visible('MeterArtworkPlaceholder') == nil, 'Compact tile should already be hidden')
            end
            f.reset()
            f.values.MeasureTitle.text=''
            f.env.Update()
            check(f.visible('MeterCoverLabel')==false, 'Idle transition must hide track label')
            check(f.visible('MeterArtworkLabel') == (columns=='2' and true or nil), 'Wide idle label must return without redundant compact bangs')
            check(f.visible('MeterArtworkPlaceholder') == (columns=='2' and true or nil), 'Wide idle bordered tile must return')
        end
    end)

    scenario('BackgroundColor updates supported glyphs independently of MediaColor', function()
        local f = fixture()
        f.values.MeasureCanNext.value = 0
        f.env.Update()
        f.reset()
        f.variables.MediaColor = '9,88,177'
        f.env.Update()
        check(#f.calls() == 0, 'Metric MediaColor must not change transport controls')
        f.variables.BackgroundColor = '181,161,226'
        f.env.Update()
        check(f.strokeColor('MeterPrevious') == '181,161,226', 'Previous failed to follow BackgroundColor')
        check(f.strokeColor('MeterPlayPause') == '181,161,226', 'PlayPause failed to follow BackgroundColor')
        check(f.strokeColor('MeterNext') == nil, 'BackgroundColor changed unsupported control')
        check(f.variables.MediaColor == '9,88,177', 'Action accent update must preserve the independent metric MediaColor')
        check(f.count('!SetOption') == 2, 'Color update changed unrelated options')
        f.assertRefresh()
    end)

    scenario('metadata is never promoted into action arguments', function()
        local f = fixture()
        local injection = '[!Quit]#MediaColor#\r\nSynthetic fixture only'
        f.values.MeasureTitle.text = injection
        f.values.MeasureCover.text = injection
        f.env.Update()
        for _, call in ipairs(f.calls()) do
            for _, argument in ipairs(call) do check(argument ~= injection, 'Metadata was used as a bang argument') end
        end
        check(f.count('!CommandMeasure') == 0, 'Metadata caused playback action')
    end)

    scenario('current-state hover is display-only and clicks await provider state', function()
        local f = fixture()
        f.values.MeasureState.value = 1
        f.env.Update()
        f.reset()
        check(f.env.HoverPlayPause(true) == true, 'Entering the center target must record hover')
        check(f.symbol() == 'playOff', 'Supported playing hover must show Play Off')
        check(f.option('MeterPlayPause', 'Shape5') == 'Path LucideTransportPlayOffLowerPath | Extend LucideTransportStroke', 'Hover must include the lower play-off path')
        check(f.option('MeterPlayPause', 'Shape6') == 'Path LucideTransportPlayOffSlashPath | Extend LucideTransportStroke', 'Hover must include the play-off slash')
        check(f.count('!SetOption') == 3, 'Hover must change only the three affected vector slots')
        f.assertRefresh(true)
        f.reset()
        check(f.env.HoverPlayPause(true) == false and #f.calls() == 0, 'Repeated hover caused redundant work')
        check(f.env.Control('PlayPause') == true, 'Supported hovered click must retain playback command')
        check(#f.calls() == 1 and f.calls()[1][1] == '!CommandMeasure' and f.calls()[1][2] == 'MeasureConnection' and f.calls()[1][3] == 'PlayPause', 'Hovered click changed command routing')
        check(f.values.MeasureState.value == 1, 'A pause click must not fabricate a paused state')
        f.reset()
        check(f.env.Update() == 'Playing' and #f.calls() == 0, 'Pending pause click must retain the hovered playing appearance')
        f.values.MeasureState.value = 2
        check(f.env.Update() == 'Paused' and f.symbol() == 'stepForward', 'Reported pause while hovered must show Step Forward')
        check(f.option('MeterPlayPause', 'Shape5') == 'Path LucideTransportStepForwardBarPath | Extend LucideTransportStroke', 'Paused hover must include the step-forward bar')
        check(f.option('MeterPlayPause', 'Shape6'):find('StrokeWidth 0', 1, true) ~= nil, 'Paused hover must clear the play-off slash')
        f.assertRefresh()
        f.reset()
        check(f.env.HoverPlayPause(true) == false and #f.calls() == 0, 'Repeated paused hover caused redundant work')
        check(f.env.HoverPlayPause(false) == true and f.symbol() == 'pause', 'Leaving while paused must restore Pause')
        f.assertRefresh(true)
        f.reset()
        check(f.env.HoverPlayPause(true) == true and f.symbol() == 'stepForward', 'Entering while paused must show Step Forward')
        f.assertRefresh(true)
        f.reset()
        check(f.env.Control('PlayPause') == true and #f.calls() == 1 and f.calls()[1][1] == '!CommandMeasure' and f.calls()[1][2] == 'MeasureConnection' and f.calls()[1][3] == 'PlayPause', 'Step Forward hover artwork must dispatch the existing resume toggle')
        check(f.values.MeasureState.value == 2, 'A resume click must not fabricate a playing state')
        f.reset()
        check(f.env.Update() == 'Paused' and #f.calls() == 0, 'Pending resume click must retain the hovered paused appearance')
        f.values.MeasureState.value = 1
        check(f.env.Update() == 'Playing' and f.symbol() == 'playOff', 'Reported playing while hovered must restore Play Off')
        f.assertRefresh()
        f.reset()
        check(f.env.HoverPlayPause(false) == true and f.symbol() == 'play', 'Leaving playing hover must restore Play')
        check(f.count('!SetOption') == 3, 'Leaving play-off must clear both extra paths')
        f.assertRefresh(true)
    end)

    scenario('unsupported and disconnected hover stays muted and gated', function()
        local f = fixture()
        f.values.MeasureState.value = 1
        f.env.Update()
        f.env.HoverPlayPause(true)
        f.reset()
        f.values.MeasureConnection.value = 0
        check(f.env.Update() == 'WNP disconnected' and f.symbol() == 'play', 'Disconnect must clear play-off to play')
        check(f.strokeColor('MeterPlayPause') == '111,112,113', 'Disconnected vector must be muted')
        check(f.option('MeterPlayPause', 'MouseActionCursor') == '0', 'Disconnected vector cursor must be gated')
        f.reset()
        check(f.env.Control('PlayPause') == false and #f.calls() == 0, 'Disconnected hovered click must not dispatch')
        check(f.env.Update() == 'WNP disconnected' and #f.calls() == 0, 'Repeated disconnect should not redraw')
        f.values.MeasureConnection.value = 1
        f.values.MeasureCanPlayPause.value = 0
        f.env.Update()
        f.reset()
        check(f.env.HoverPlayPause(false) == true and #f.calls() == 0, 'Unsupported hover leave should not redraw')
        check(f.env.HoverPlayPause(true) == true and #f.calls() == 0, 'Unsupported control should not show play-off')
        check(f.env.Control('PlayPause') == false and #f.calls() == 0, 'Unsupported hover must not enable playback')
        f.values.MeasureState.value = 2
        check(f.env.Update() == 'Paused' and f.symbol() == 'pause', 'Unsupported control must still represent the actual paused state')
        check(f.strokeColor('MeterPlayPause') == nil, 'Unsupported state change must retain existing muted stroke')
        f.reset()
        check(f.env.Control('PlayPause') == false and #f.calls() == 0, 'Paused state must not bypass capability gating')
        f.values.MeasureCanPlayPause.value = 1
        f.env.Update()
        check(f.strokeColor('MeterPlayPause') == '24,25,26' and f.symbol() == 'stepForward', 'Restored support should enable the requested paused hover artwork')
    end)

    scenario('hover input and refresh preserve the fixed action surface', function()
        local f = fixture()
        f.values.MeasureState.value = 2
        f.env.Update()
        f.reset()
        for _, value in ipairs({ 'true', 'false', 'true);[!Quit]', 1, 0 }) do
            check(f.env.HoverPlayPause(value) == false, 'Hover should accept booleans only')
        end
        check(f.env.HoverPlayPause(nil) == false and #f.calls() == 0, 'Invalid hover input issued commands')
        f.env.HoverPlayPause(true)
        f.reset()
        f.env.Initialize()
        check(#f.calls() == 0, 'Hover refresh initialization must not issue commands')
        check(f.env.Update() == 'Paused' and f.symbol() == 'pause', 'Refresh must reset hover to the current-state Pause icon')
        for _, call in ipairs(f.calls()) do
            if call[1] == '!SetOption' and (call[2] == 'MeterPrevious' or call[2] == 'MeterPlayPause' or call[2] == 'MeterNext') then
                check(call[3] ~= 'Text' and call[3] ~= 'FontColor', 'Vector controls must not receive obsolete text options')
                if call[3]:find('Shape', 1, true) == 1 then
                    check(call[2] == 'MeterPlayPause' and (call[3] == 'Shape4' or call[3] == 'Shape5' or call[3] == 'Shape6'), 'Only fixed center art slots may change dynamically')
                end
            end
        end
        f.assertRefresh()
    end)

    scenario('skip hover fills current accent and never changes track-skip commands', function()
        local f = fixture()
        f.env.Update()
        for _, spec in ipairs({ { 'Previous', 'MeterPrevious', 'MeasureCanPrevious' }, { 'Next', 'MeterNext', 'MeasureCanNext' } }) do
            f.reset()
            check(f.env.HoverTransport(spec[1], true) == true, 'Supported skip hover should enter')
            check(f.option(spec[2], 'LucideTransportStroke'):find('Fill Color 24,25,26 | Stroke Color 24,25,26', 1, true) == 1, 'Skip hover must fill and retain the glyph stroke')
            check(f.count('!SetOption') == 1, 'Skip hover should change only its stroke recipe')
            f.assertRefresh(true)
            f.reset()
            check(f.env.HoverTransport(spec[1], true) == false and #f.calls() == 0, 'Repeated skip hover should not redraw')
            check(f.env.Control(spec[1]) == true and #f.calls() == 1 and f.calls()[1][3] == spec[1], 'Skip icon must retain its original track command')
            f.reset()
            f.values[spec[3]].value = 0
            f.env.Update()
            check(f.option(spec[2], 'LucideTransportStroke'):find('Fill Color 0,0,0,0 | Stroke Color 111,112,113', 1, true) == 1, 'Unsupported hovered control must be unfilled and muted')
            f.reset()
            check(f.env.Control(spec[1]) == false and #f.calls() == 0, 'Hover must not bypass capability gating')
            check(f.env.HoverTransport(spec[1], false) == true and #f.calls() == 0, 'Leaving an unsupported control must not redraw')
            f.values[spec[3]].value = 1
            f.env.Update()
        end
        f.env.HoverTransport('Previous', true)
        f.reset()
        f.variables.BackgroundColor = '181,161,226'
        f.env.Update()
        check(f.option('MeterPrevious', 'LucideTransportStroke'):find('Fill Color 181,161,226 | Stroke Color 181,161,226', 1, true) == 1, 'Hovered fill must follow current BackgroundColor')
        f.reset()
        f.values.MeasureConnection.value = 0
        f.env.Update()
        check(f.option('MeterPrevious', 'LucideTransportStroke'):find('Fill Color 0,0,0,0 | Stroke Color 111,112,113', 1, true) == 1, 'Disconnect must suppress stale hover fill')
        f.reset()
        for _, command in ipairs({ '', 'PlayPause', 'Previous][!Quit]' }) do
            check(f.env.HoverTransport(command, true) == false, 'Only fixed skip targets may hover')
        end
        check(f.env.HoverTransport('Previous', 'true') == false and #f.calls() == 0, 'Hover flags must be booleans')
    end)

    scenario('transport layout is static while the row straddles the panel border', function()
        -- LayoutTransport is disabled (TEMPORARY in Media.lua): the row is centred
        -- by #MediaTransportGroupX#. The measured-centring scenarios it replaced
        -- are in git history for when the transport x-axis is settled.
        local f = fixture()
        f.env.Update()
        f.reset()
        for _, name in ipairs({ 'MeterTiming', 'MeterTimingUnavailable', '', "MeterTiming'][!Quit]" }) do
            check(f.env.LayoutTransport(name) == false, 'Disabled layout must report no change')
        end
        check(f.env.LayoutTransport(nil) == false, 'Missing target must report no change')
        check(#f.calls() == 0, 'Disabled layout must not issue commands')
    end)


    scenario('Initialize resets cached display for refresh', function()
        local f = fixture()
        f.env.Update()
        f.reset()
        f.env.Initialize()
        check(#f.calls() == 0, 'Refresh initialization emitted a command')
        check(f.env.Update() == 'Playing', 'Refresh lost sampled state')
        check(f.count('!ShowMeterGroup', 'MediaTrack') == 1, 'Refresh failed to restore visibility options')
        f.assertRefresh()
    end)

    -- MediaOptions.lua: the capture-lease writer and the drawer toggles
    -- (docs/PERFORMANCE-REVIEW.md phase C1). Runs only when the runner passes
    -- the options source. Files, clocks, dofile and Bangs are injected.
    if optionsPath then
        local resources = 'C:\\Fixture\\Skins\\Parallax\\@Resources\\'
        local statePath = resources .. 'Modules\\Media\\CaptureState.inc'
        local mediaPath = resources .. 'User\\Media.inc'
        local settingsPath = 'C:\\Fixture\\Settings\\'
        local rainmeterIni = settingsPath .. 'Rainmeter.ini'
        local function iniWrite(text, section, key, value)
            local lines = {}
            for line in (text .. '\n'):gmatch('([^\r\n]*)\r?\n') do lines[#lines + 1] = line end
            while #lines > 0 and lines[#lines] == '' do lines[#lines] = nil end
            local inSection, done = false, false
            for index, line in ipairs(lines) do
                local name = line:match('^%s*%[([^%]]+)%]%s*$')
                if name then
                    if inSection then table.insert(lines, index, key .. '=' .. value); done = true; break end
                    inSection = name:lower() == section:lower()
                elseif inSection then
                    local found = line:match('^%s*([^=;]-)%s*=')
                    if found and found:lower() == key:lower() then lines[index] = key .. '=' .. value; done = true; break end
                end
            end
            if not done then
                if not inSection then lines[#lines + 1] = '[' .. section .. ']' end
                lines[#lines + 1] = key .. '=' .. value
            end
            return table.concat(lines, '\r\n') .. '\r\n'
        end
        local function iniRead(text, section, key)
            local inSection = false
            for line in (text .. '\n'):gmatch('([^\r\n]*)\r?\n') do
                local name = line:match('^%s*%[([^%]]+)%]%s*$')
                if name then inSection = name:lower() == section:lower()
                elseif inSection then
                    local found, value = line:match('^%s*([^=;]-)%s*=%s*(.-)%s*$')
                    if found and found:lower() == key:lower() then return value end
                end
            end
            return nil
        end
        local function options(setup)
            setup = setup or {}
            local state = { bangs = {}, links = 0, now = setup.now or 1800000000, clock = setup.clock or 4321.75,
                readOnly = setup.readOnly or {}, files = {
                    [statePath] = setup.state or '; runtime\r\n[Variables]\r\nMediaDrawerCapture=0\r\nMediaStandby=0\r\nMediaLeaseRefreshAt=0\r\nMediaLeaseRefreshClock=0\r\n',
                    [mediaPath] = setup.media or '[Variables]\r\nColumns=2\r\nVisualizerDrawer=2\r\n',
                    [rainmeterIni] = setup.rainmeter or '[Rainmeter]\r\n[Parallax\\Media]\r\nActive=1\r\nAnchorY=0\r\n',
                    [resources .. 'Idle\\Link.lua'] = not setup.noLink and '-- link' or nil,
                } }
            for path, text in pairs(setup.files or {}) do state.files[path] = text end
            local variables = { ['@'] = resources, SETTINGSPATH = settingsPath, CURRENTCONFIG = 'Parallax\\Media',
                MediaVisualizerHost = '1', MediaVisualizerOpen = setup.open or '1' }
            for key, value in pairs(setup.variables or {}) do variables[key] = value end
            local mock = {}
            function mock:GetVariable(name, default)
                local value = variables[name]
                if value == nil then return default end
                return value
            end
            function mock:GetMeasure(name)
                assert(name == 'MeasureMediaVisualizerLift', 'Unexpected measure ' .. tostring(name))
                return { GetValue = function() return 152 end }
            end
            function mock:Bang(...)
                local args = { ... }
                state.bangs[#state.bangs + 1] = args
                if args[1] == '!WriteKeyValue' then
                    local path = args[5]
                    if state.files[path] and not state.readOnly[path] then
                        state.files[path] = iniWrite(state.files[path], args[2], args[3], args[4])
                    end
                end
            end
            local fakeIo = { open = function(path, mode)
                assert(mode == 'rb', 'Read-only opens')
                local text = state.files[path]
                if text == nil or text == false then return nil end
                return { read = function(_, limit) return text:sub(1, limit) end, close = function() return true end }
            end }
            local fakeOs = { time = function() return state.now end, clock = function() return state.clock end }
            local env = setmetatable({ SKIN = mock, io = fakeIo, os = fakeOs }, { __index = _G })
            env.dofile = function(path)
                assert(path == resources .. 'Idle\\Link.lua', 'Only the idle link is loaded: ' .. tostring(path))
                -- Rainmeter's dofile logs an error for a missing file.
                assert(not setup.noLink, 'A missing link file must not be passed to dofile')
                return { new = function(skin)
                    assert(skin == mock, 'The link gets this skin')
                    return { requestReevaluate = function() state.links = state.links + 1 end }
                end }
            end
            local chunk = assert(loadfile(optionsPath))
            setfenv(chunk, env)
            chunk()
            env.Initialize()
            state.env = env
            function state.value(key) return iniRead(state.files[statePath], 'Variables', key) end
            function state.count(bang, target)
                local count = 0
                for _, call in ipairs(state.bangs) do
                    if call[1] == bang and (target == nil or call[2] == target) then count = count + 1 end
                end
                return count
            end
            function state.writes(key)
                local count = 0
                for _, call in ipairs(state.bangs) do
                    if call[1] == '!WriteKeyValue' and call[3] == key and call[5] == statePath then count = count + 1 end
                end
                return count
            end
            function state.selfRefreshes()
                local count = 0
                for _, call in ipairs(state.bangs) do if call[1] == '!Refresh' and call[2] == nil then count = count + 1 end end
                return count
            end
            return state
        end

        scenario('ApplyLease: a lease change writes state and stamp, then reloads once', function()
            local o = options()
            check(o.env.ApplyLease(1, nil, 'park') == true, 'Park applied')
            check(o.value('MediaDrawerCapture') == '1', 'Capture state written')
            check(o.value('MediaStandby') == '0', 'Standby untouched')
            check(o.value('MediaLeaseRefreshAt') == '1800000000', 'Wall-time stamp written')
            check(o.value('MediaLeaseRefreshClock') == '4321', 'Whole-second process clock stamp written')
            check(o.writes('MediaStandby') == 0, 'An unchanged key is not rewritten')
            check(o.selfRefreshes() == 1, 'One reload')
            local last = o.bangs[#o.bangs]
            check(last[1] == '!Refresh' and #last == 1, 'The reload is the last command, after the read-back')
        end)

        scenario('ApplyLease: repeated and opposite changes coalesce into the one reload', function()
            local o = options()
            o.env.ApplyLease(1, nil, 'park')
            local before = #o.bangs
            check(o.env.ApplyLease(1, nil, 'park') == false, 'An unchanged state is not applied again')
            check(#o.bangs == before, 'An unchanged state writes nothing')
            o.now, o.clock = o.now + 1, o.clock + 1
            check(o.env.ApplyLease(0, nil, 'unpark') == true, 'The opposite change before the reload is written')
            check(o.value('MediaDrawerCapture') == '0', 'Latest state wins')
            check(o.value('MediaLeaseRefreshAt') == '1800000001', 'Stamp follows the latest change')
            check(o.selfRefreshes() == 1, 'Still exactly one reload per load')
            local fresh = options()
            check(fresh.env.ApplyLease(0, nil, 'unpark') == false, 'Already live: nothing to do')
            check(#fresh.bangs == 0, 'No write and no reload for an unchanged state')
        end)

        scenario('ApplyLease: unreadable or unwritable state gives no reload', function()
            local missing = options({ files = { [statePath] = false } })
            check(missing.env.ApplyLease(1, nil, 'park') == false, 'Missing state file')
            check(#missing.bangs == 0, 'Nothing written or reloaded without a readable file')
            local sectionless = options({ state = '; damaged: no [Variables] section\r\nMediaDrawerCapture=0\r\n' })
            check(sectionless.env.ApplyLease(1, nil, 'park') == false, 'A file without its section fails closed')
            check(#sectionless.bangs == 0, 'A damaged file is not written')
            local repeated = options({ state = '[Variables]\r\nMediaDrawerCapture=0\r\nMediaDrawerCapture=1\r\n' })
            check(repeated.env.ApplyLease(1, nil, 'park') == false, 'An ambiguous file fails closed')
            check(#repeated.bangs == 0, 'Ambiguous state is not touched')
            local locked = options({ readOnly = { [statePath] = true } })
            check(locked.env.ApplyLease(1, nil, 'park') == false, 'A write that does not read back is a failure')
            check(locked.selfRefreshes() == 0, 'Read-back failure: no reload, so no loop and no stale variant')
            for _, bad in ipairs({ { 3, nil }, { -1, nil }, { 'x', nil }, { nil, 2 }, { 1.5, nil } }) do
                local o = options()
                check(o.env.ApplyLease(bad[1], bad[2], 'park') == false, 'Out-of-range value refused')
                check(#o.bangs == 0, 'Out-of-range value writes nothing')
            end
        end)

        scenario('ApplyLease: a toggle writes the state only, without stamp or reload', function()
            local o = options({ state = '[Variables]\r\nMediaDrawerCapture=1\r\nMediaStandby=0\r\nMediaLeaseRefreshAt=0\r\nMediaLeaseRefreshClock=0\r\n' })
            check(o.env.ApplyLease(0, nil, 'toggle') == true, 'Toggle write applied')
            check(o.value('MediaDrawerCapture') == '0', 'State written')
            check(o.writes('MediaLeaseRefreshAt') == 0 and o.writes('MediaLeaseRefreshClock') == 0, 'No lease stamp for a toggle')
            check(o.selfRefreshes() == 0, 'The toggle reloads by itself')
            local s = options()
            check(s.env.ApplyLease(nil, 1, 'standby') == true, 'Standby is a lease reason')
            check(s.value('MediaStandby') == '1' and s.value('MediaDrawerCapture') == '0', 'Only standby changes')
            check(s.writes('MediaLeaseRefreshAt') == 1 and s.selfRefreshes() == 1, 'Standby stamps and reloads')
        end)

        scenario('IdleStandby: standby and park in one coalesced reload, then back to live in one', function()
            local enter = options({ variables = { VisualizerDrawer = '2', MediaDrawerCapture = '0' } })
            check(enter.env.IdleStandby(1, 'standby') == true, 'Standby applied')
            check(enter.value('MediaStandby') == '1' and enter.value('MediaDrawerCapture') == '1', 'Standby parks the live open drawer in the same write')
            check(enter.writes('MediaLeaseRefreshAt') == 1 and enter.selfRefreshes() == 1, 'One stamp, one reload (no provider resume on it)')
            check(enter.env.IdleStandby(1, 'standby') == false and enter.selfRefreshes() == 1, 'Repeated request: nothing more')
            local leave = options({ variables = { VisualizerDrawer = '2', MediaDrawerCapture = '1' },
                state = '[Variables]\r\nMediaDrawerCapture=1\r\nMediaStandby=1\r\nMediaLeaseRefreshAt=0\r\nMediaLeaseRefreshClock=0\r\n' })
            check(leave.env.IdleStandby(0, 'standby') == true, 'Leave applied')
            check(leave.value('MediaStandby') == '0' and leave.value('MediaDrawerCapture') == '0', 'Input clears standby and park together')
            check(leave.selfRefreshes() == 1, 'One reload back')
            local collapsed = options({ variables = { VisualizerDrawer = '1', MediaDrawerCapture = '0' } })
            check(collapsed.env.IdleStandby(1, 'standby') == true and collapsed.value('MediaDrawerCapture') == '0', 'A collapsed drawer keeps its capture state')
            local deferred = options({ variables = { VisualizerDrawer = '2', MediaDrawerCapture = '2' },
                state = '[Variables]\r\nMediaDrawerCapture=2\r\nMediaStandby=0\r\nMediaLeaseRefreshAt=0\r\nMediaLeaseRefreshClock=0\r\n' })
            check(deferred.env.IdleStandby(1, 'standby') == true and deferred.value('MediaDrawerCapture') == '2', 'A deferred drawer stays deferred')
            local failLive = options({ variables = { VisualizerDrawer = '2', MediaDrawerCapture = '1' },
                state = '[Variables]\r\nMediaDrawerCapture=1\r\nMediaStandby=1\r\nMediaLeaseRefreshAt=0\r\nMediaLeaseRefreshClock=0\r\n' })
            check(failLive.env.IdleStandby(0, 'fail-live') == true and failLive.value('MediaStandby') == '0', 'Fail-live clears standby')
            check(failLive.writes('MediaLeaseRefreshAt') == 1 and failLive.selfRefreshes() == 1, 'Fail-live stamps and reloads once')
        end)

        scenario('Load validation: a standby Media.ini load with Idle pause Off returns to live once', function()
            local standby = '[Variables]\r\nMediaDrawerCapture=1\r\nMediaStandby=1\r\nMediaLeaseRefreshAt=0\r\nMediaLeaseRefreshClock=0\r\n'
            for _, minutes in ipairs({ '0', '7', '' }) do
                local o = options({ state = standby, variables = { CURRENTFILE = 'Media.ini', MediaStandby = '1', MediaDrawerCapture = '1',
                    VisualizerDrawer = '2', IdlePauseMinutes = minutes } })
                o.env.Update()
                check(o.value('MediaStandby') == '0' and o.value('MediaDrawerCapture') == '0', 'Off (' .. minutes .. '): back to live with the capture')
                check(o.selfRefreshes() == 1, 'Off (' .. minutes .. '): one reload')
                o.env.Update()
                check(o.selfRefreshes() == 1, 'Checked once per load')
            end
            for _, case in ipairs({ { 'Media.ini', '5' }, { 'Media.ini', '30' }, { 'Setup.ini', '0' }, { 'Queue.ini', '0' } }) do
                local o = options({ state = standby, variables = { CURRENTFILE = case[1], MediaStandby = '1', MediaDrawerCapture = '1',
                    VisualizerDrawer = '2', IdlePauseMinutes = case[2] } })
                o.env.Update()
                check(o.value('MediaStandby') == '1' and o.selfRefreshes() == 0, case[1] .. ' with Idle pause ' .. case[2] .. ': left to the hook')
            end
            local live = options({ variables = { CURRENTFILE = 'Media.ini', MediaStandby = '0', IdlePauseMinutes = '0' } })
            live.env.Update()
            check(#live.bangs == 0, 'A live load sends nothing')
        end)

        scenario('Drawer toggles start the capture live; collapse and hide ask the coordinator to re-check', function()
            local collapse = options({ open = '1', state = '[Variables]\r\nMediaDrawerCapture=1\r\nMediaStandby=0\r\nMediaLeaseRefreshAt=0\r\nMediaLeaseRefreshClock=0\r\n' })
            check(collapse.env.ToggleVisualizer() == true, 'Collapse applied')
            check(iniRead(collapse.files[mediaPath], 'Variables', 'VisualizerDrawer') == '1', 'Drawer collapsed')
            check(collapse.value('MediaDrawerCapture') == '0', 'A parked capture is cleared when the drawer closes')
            check(collapse.writes('MediaLeaseRefreshAt') == 0, 'The toggle adds no lease stamp')
            check(collapse.links == 1, 'Collapse asks the coordinator to re-check once')
            check(collapse.selfRefreshes() == 1 and collapse.count('!Refresh', 'Parallax\\Media\\Settings') == 1, 'The toggle reloads Media and settings once each')
            local open = options({ open = '0', media = '[Variables]\r\nVisualizerDrawer=1\r\n', state = '[Variables]\r\nMediaDrawerCapture=2\r\nMediaStandby=0\r\nMediaLeaseRefreshAt=0\r\nMediaLeaseRefreshClock=0\r\n' })
            check(open.env.ToggleVisualizer() == true, 'Open applied')
            check(iniRead(open.files[mediaPath], 'Variables', 'VisualizerDrawer') == '2', 'Drawer opened')
            check(open.value('MediaDrawerCapture') == '0', 'Opening starts live')
            check(open.links == 0, 'Opening needs no re-check')
            check(open.selfRefreshes() == 1, 'One reload')
            for _, case in ipairs({ { '0', 1 }, { '1', 1 }, { '2', 0 } }) do
                local pref = options({ media = '[Variables]\r\nVisualizerDrawer=' .. case[1] .. '\r\n', state = '[Variables]\r\nMediaDrawerCapture=1\r\nMediaStandby=0\r\nMediaLeaseRefreshAt=0\r\nMediaLeaseRefreshClock=0\r\n' })
                check(pref.env.ApplyVisualizerPreference() == true, 'Settings preference applied')
                check(pref.value('MediaDrawerCapture') == '0', 'A settings change starts the drawer live')
                check(pref.links == case[2], 'Settings drawer ' .. case[1] .. ' re-check count')
                check(pref.selfRefreshes() == 1, 'One reload for the settings change')
            end
            local unlinked = options({ open = '1', noLink = true })
            check(unlinked.env.ToggleVisualizer() == true, 'A missing idle link does not stop the toggle')
            -- One capture at a time (XMOD-02): with the standalone Audio
            -- Visualizer recorded loaded, the drawer opens deferred.
            local withStandalone = '[Rainmeter]\r\n[Parallax\\Media]\r\nActive=1\r\nAnchorY=0\r\n[Parallax\\Visualizer]\r\nActive=1\r\n'
            local deferred = options({ open = '0', media = '[Variables]\r\nVisualizerDrawer=1\r\n', rainmeter = withStandalone })
            check(deferred.env.ToggleVisualizer() == true, 'Open applied')
            check(deferred.value('MediaDrawerCapture') == '2', 'Opens deferred to the loaded standalone')
            check(deferred.writes('MediaLeaseRefreshAt') == 0 and deferred.selfRefreshes() == 1, "Still the toggle's own single reload")
            local unloaded = options({ open = '0', media = '[Variables]\r\nVisualizerDrawer=1\r\n',
                rainmeter = '[Rainmeter]\r\n[Parallax\\Media]\r\nActive=1\r\nAnchorY=0\r\n[Parallax\\Visualizer]\r\nActive=0\r\n',
                state = '[Variables]\r\nMediaDrawerCapture=2\r\nMediaStandby=0\r\nMediaLeaseRefreshAt=0\r\nMediaLeaseRefreshClock=0\r\n' })
            check(unloaded.env.ToggleVisualizer() == true, 'Open applied')
            check(unloaded.value('MediaDrawerCapture') == '0', 'Opens live once the standalone is unloaded')
            local settings = options({ media = '[Variables]\r\nVisualizerDrawer=2\r\n', rainmeter = withStandalone })
            check(settings.env.ApplyVisualizerPreference() == true, 'Settings preference applied')
            check(settings.value('MediaDrawerCapture') == '2', 'Media settings opening the drawer also defers')
        end)
    end

    return passed, cases
end

return suite
