; Derived options. User choices are read earlier and are never persisted here.
[Variables]
VisualizerEffectiveInterval=(#VisualizerUpdateOverride#=0 ? (#VisualizerInterval#=33 ? 33 : (#VisualizerInterval#=100 ? 100 : 50)) : (#VisualizerUpdateOverride#=33 ? 33 : (#VisualizerUpdateOverride#=100 ? 100 : 50)))
VisualizerFFTSize=(#VisualizerQuality#<=0 ? 512 : (#VisualizerQuality#>=2 ? 2048 : 1024))
VisualizerAttackMs=(Max(0,Min(2000,#VisualizerAttack#)))
VisualizerDecayMs=(Max(0,Min(5000,#VisualizerDecay#)))
VisualizerSensitivityDb=(Max(10,Min(80,#VisualizerSensitivity#)))
VisualizerIdleFloor=(Max(0.00001,Min(0.1,#VisualizerIdleThreshold#)))
; Runtime-only provider evidence. Never written to the user's settings.
VisualizerFormatInvalid=0
VisualizerVolumeAvailable=0
VisualizerVolumeDivider=(Max(1,Round(250/#VisualizerEffectiveInterval#)))
; Reclaim the status row and footer for the spectrum; keep thick-border clearance.
VisualizerTopShift=(Max(0,#BorderThickness#-2))
VisualizerPlotTop=(43+#VisualizerTopShift#)
; Keep all three dB labels readable when a short panel uses a large axis gap.
; Only derived height grows; the user's saved PanelHeight is untouched.
VisualizerBaselineGapPx=(Round(Max(0,Min(24,#VisualizerBaselineGap#))*#Scale#))
VisualizerPlotHeightPx=(Max(Round((#PanelHeight#-66-#VisualizerTopShift#)*#Scale#),Ceil(54*#Scale#)+#VisualizerBaselineGapPx#+2))
VisualizerPlotHeight=(#VisualizerPlotHeightPx#/#Scale#)
PanelHeightPx=(Round((66+#VisualizerTopShift#)*#Scale#)+#VisualizerPlotHeightPx#)
WindowHeight=(#PanelHeightPx#+#Gap#)
VisualizerBandGapPx=(Max(0,Round(Max(0,Min(4,#VisualizerBandGap#))*#Scale#)))
; Reserve the spectrum dB scale inside the panel.
VisualizerAxisWidth=(40*#Scale#)
VisualizerPlotX=(#ContentX#+#VisualizerAxisWidth#)
VisualizerPlotWidth=(#ContentWidth#-#VisualizerAxisWidth#)
VisualizerPlotInnerWidth=(#VisualizerPlotWidth#-2)
VisualizerPlotInnerHeight=(#VisualizerPlotHeightPx#-2)
VisualizerBarHeight=(#VisualizerPlotInnerHeight#-#VisualizerBaselineGapPx#)
VisualizerBarRadiusPx=(Max(0,Min(12,#VisualizerBarRadius#))*#Scale#)

; Per-band expressions are evaluated by the native dynamic Shape mask.
VisualizerBandLeft0=(Round(0*#VisualizerPlotInnerWidth#/24))
VisualizerBandWidth0=(Max(1,Round(1*#VisualizerPlotInnerWidth#/24)-Round(0*#VisualizerPlotInnerWidth#/24)-#VisualizerBandGapPx#))
VisualizerBandHeight0=(Round(Max(0,Min(1,[MeasureVisualizerBand0]))*#VisualizerBarHeight#))
VisualizerBandTop0=(#VisualizerBarHeight#-#VisualizerBandHeight0#)
VisualizerBandRadius0=(Min(#VisualizerBarRadiusPx#,Min(#VisualizerBandWidth0#/2,#VisualizerBandHeight0#)))
VisualizerBandLeft1=(Round(1*#VisualizerPlotInnerWidth#/24))
VisualizerBandWidth1=(Max(1,Round(2*#VisualizerPlotInnerWidth#/24)-Round(1*#VisualizerPlotInnerWidth#/24)-#VisualizerBandGapPx#))
