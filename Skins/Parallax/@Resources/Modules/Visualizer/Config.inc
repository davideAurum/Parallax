VisualizerBandTop1=(#VisualizerBarHeight#-#VisualizerBandHeight1#)
VisualizerBandRadius1=(Min(#VisualizerBarRadiusPx#,Min(#VisualizerBandWidth1#/2,#VisualizerBandHeight1#)))
